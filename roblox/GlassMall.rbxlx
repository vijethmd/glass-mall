<Item class="ServerScriptService" referent="RBX02BE0"><Properties>
<string name="Name">ServerScriptService</string>
</Properties>
<Item class="Script" referent="RBX02BE1"><Properties>
<string name="Name">Cars</string>
<ProtectedString name="Source"><![CDATA[-- Drivable cars. Parked cars wait around the city, and the "Get a car" pads give you
-- your own. Each car is a chassis on four wheels joined by hinge constraints: the
-- front wheels steer with servos and all four are driven by motors that follow the
-- VehicleSeat (W/S or arrow keys to drive, A/D to steer, Space to get out).
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")

local spawns = workspace:WaitForChild("CarSpawns")
local folder = Instance.new("Folder")
folder.Name = "DrivableCars"
folder.Parent = workspace

local WHEEL_R = 1.4
local FORWARD = -1 -- motor direction that rolls the car forward
local STEER = -1 -- servo direction that turns the front wheels left for A
local DRIVE_TORQUE = 7500
local BRAKE_TORQUE = 12000
local COAST_TORQUE = 500

local PAINT = {
	Color3.fromRGB(200, 36, 40), Color3.fromRGB(30, 90, 190), Color3.fromRGB(240, 240, 236), Color3.fromRGB(24, 26, 30),
	Color3.fromRGB(250, 190, 30), Color3.fromRGB(40, 150, 90), Color3.fromRGB(150, 156, 162), Color3.fromRGB(240, 120, 30),
	Color3.fromRGB(110, 60, 170), Color3.fromRGB(20, 160, 180),
}
local STYLES = {
	{ name = "Sedan", length = 15, width = 7, body = 2.2, cabin = { 8.5, 2.3, 0.6 }, top = 95 },
	{ name = "Coupe", length = 14, width = 7.2, body = 1.9, cabin = { 6.5, 1.9, 1.0 }, top = 120 },
	{ name = "Pickup", length = 17, width = 7.6, body = 2.6, cabin = { 6, 2.6, -2.6 }, top = 85 },
}

local rng = Random.new()
local cars = {}
local owned = {}

local function newPart(model, name, size, cf, color, material, props)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props then
		for k, v in pairs(props) do
			p[k] = v
		end
	end
	p.Parent = model
	return p
end

local function weld(a, b)
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = a
end

local function attach(part, name, pos, axis, secondary)
	local a = Instance.new("Attachment")
	a.Name = name
	a.Position = pos
	a.Axis = axis
	a.SecondaryAxis = secondary
	a.Parent = part
	return a
end

local function prompt(seat, action, objectText)
	local p = Instance.new("ProximityPrompt")
	p.ActionText = action
	p.ObjectText = objectText
	p.HoldDuration = 0
	p.MaxActivationDistance = 12
	p.RequiresLineOfSight = false
	p.Parent = seat
	p.Triggered:Connect(function(player)
		local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if humanoid and not seat.Occupant and humanoid.Health > 0 then
			humanoid.Sit = false -- out of any other seat first
			task.wait()
			seat:Sit(humanoid)
		end
	end)
	return p
end

local function buildCar(base, style, color, owner)
	local model = Instance.new("Model")
	model.Name = style.name
	local L, W = style.length, style.width
	local baseY = WHEEL_R + 0.3
	local chassis = newPart(model, "Chassis", Vector3.new(W - 1, 0.8, L - 1), base * CFrame.new(0, baseY, 0),
		Color3.fromRGB(30, 30, 34), Enum.Material.Metal)
	chassis.CustomPhysicalProperties = PhysicalProperties.new(2.5, 0.3, 0, 1, 1)
	model.PrimaryPart = chassis

	local bodyY = baseY + 0.4 + style.body / 2
	local shell = {}
	local function shellPart(name, size, offset, colour, material, props)
		local p = newPart(model, name, size, base * offset, colour, material, props)
		p.Massless = true
		weld(chassis, p)
		table.insert(shell, p)
		return p
	end
	local body = shellPart("Body", Vector3.new(W, style.body, L), CFrame.new(0, bodyY, 0), color,
		Enum.Material.SmoothPlastic, { Reflectance = 0.08 })
	local c = style.cabin
	local cabinY = bodyY + style.body / 2 + c[2] / 2
	shellPart("Windows", Vector3.new(W - 0.6, c[2], c[1]), CFrame.new(0, cabinY, c[3]), Color3.fromRGB(28, 34, 42),
		Enum.Material.Glass, { Transparency = 0.25, Reflectance = 0.25, CanCollide = false })
	shellPart("Roof", Vector3.new(W - 0.5, 0.25, c[1] - 0.6), CFrame.new(0, cabinY + c[2] / 2 + 0.12, c[3]), color,
		Enum.Material.SmoothPlastic, { CanCollide = false })
	shellPart("Bumper", Vector3.new(W + 0.2, 0.7, 0.5), CFrame.new(0, baseY + 0.6, -L / 2 - 0.1), Color3.fromRGB(40, 40, 44))
	shellPart("Bumper", Vector3.new(W + 0.2, 0.7, 0.5), CFrame.new(0, baseY + 0.6, L / 2 + 0.1), Color3.fromRGB(40, 40, 44))
	local lamps = {}
	for _, side in ipairs({ -1, 1 }) do
		local head = shellPart("Headlight", Vector3.new(1.4, 0.5, 0.1), CFrame.new(side * (W / 2 - 1), bodyY + 0.3, -L / 2 - 0.05),
			Color3.fromRGB(255, 246, 220), Enum.Material.Neon, { CanCollide = false })
		local beam = Instance.new("SpotLight")
		beam.Face = Enum.NormalId.Front
		beam.Range = 45
		beam.Angle = 70
		beam.Brightness = 3
		beam.Enabled = false
		beam.Parent = head
		table.insert(lamps, beam)
		shellPart("Taillight", Vector3.new(1.4, 0.5, 0.1), CFrame.new(side * (W / 2 - 1), bodyY + 0.3, L / 2 + 0.05),
			Color3.fromRGB(220, 30, 30), Enum.Material.Neon, { CanCollide = false })
	end

	local seat = Instance.new("VehicleSeat")
	seat.Name = "DriveSeat"
	seat.Size = Vector3.new(2, 0.5, 2)
	seat.CFrame = base * CFrame.new(-W / 4 + 0.3, bodyY + style.body / 2 + 0.25, c[3] + 0.6)
	seat.Color = Color3.fromRGB(30, 30, 34)
	seat.HeadsUpDisplay = false
	seat.MaxSpeed = style.top
	seat.Massless = true
	seat.Parent = model
	weld(chassis, seat)
	prompt(seat, "Drive", style.name)
	local passenger = Instance.new("Seat")
	passenger.Name = "PassengerSeat"
	passenger.Size = Vector3.new(2, 0.5, 2)
	passenger.CFrame = base * CFrame.new(W / 4 - 0.3, bodyY + style.body / 2 + 0.25, c[3] + 0.6)
	passenger.Color = Color3.fromRGB(30, 30, 34)
	passenger.Massless = true
	passenger.Parent = model
	weld(chassis, passenger)
	prompt(passenger, "Ride", style.name)

	local motors, servos = {}, {}
	for _, w in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
		local side, fz = w[1], w[2]
		local pos = Vector3.new(side * (W / 2 - 0.3), WHEEL_R - baseY, fz * (L / 2 - 2.8))
		local wheelCf = chassis.CFrame * CFrame.new(pos)
		local wheel = newPart(model, "Wheel", Vector3.new(1.3, WHEEL_R * 2, WHEEL_R * 2), wheelCf, Color3.fromRGB(26, 26, 28),
			Enum.Material.SmoothPlastic, { Shape = Enum.PartType.Cylinder })
		wheel.CustomPhysicalProperties = PhysicalProperties.new(1, 1.4, 0, 100, 1)
		for _, other in ipairs({ chassis, body }) do -- the wheel sits partly inside both
			local nc = Instance.new("NoCollisionConstraint")
			nc.Part0 = wheel
			nc.Part1 = other
			nc.Parent = wheel
		end
		local holder, holderPos = chassis, pos
		if fz < 0 then
			local knuckle = newPart(model, "Knuckle", Vector3.new(0.6, 0.6, 0.6), wheelCf, Color3.new(0, 0, 0), nil,
				{ Transparency = 1, CanCollide = false })
			local s0 = attach(chassis, "Steer", pos, Vector3.new(0, 1, 0), Vector3.new(1, 0, 0))
			local s1 = attach(knuckle, "Steer", Vector3.zero, Vector3.new(0, 1, 0), Vector3.new(1, 0, 0))
			local steer = Instance.new("HingeConstraint")
			steer.Attachment0 = s0
			steer.Attachment1 = s1
			steer.ActuatorType = Enum.ActuatorType.Servo
			steer.ServoMaxTorque = 1e6
			steer.AngularSpeed = 6
			steer.LimitsEnabled = true
			steer.LowerAngle = -40
			steer.UpperAngle = 40
			steer.Parent = knuckle
			table.insert(servos, steer)
			holder, holderPos = knuckle, Vector3.zero
		end
		local a0 = attach(holder, "Axle", holderPos, Vector3.new(1, 0, 0), Vector3.new(0, 1, 0))
		local a1 = attach(wheel, "Axle", Vector3.zero, Vector3.new(1, 0, 0), Vector3.new(0, 1, 0))
		local motor = Instance.new("HingeConstraint")
		motor.Attachment0 = a0
		motor.Attachment1 = a1
		motor.ActuatorType = Enum.ActuatorType.Motor
		motor.MotorMaxTorque = COAST_TORQUE
		motor.MotorMaxAcceleration = 70
		motor.Parent = wheel
		table.insert(motors, motor)
	end

	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	model.Parent = folder
	local car = {
		model = model, chassis = chassis, seat = seat, passenger = passenger, motors = motors, servos = servos,
		lamps = lamps, style = style, owner = owner, home = base, idle = 0, flipped = 0,
	}
	seat:GetPropertyChangedSignal("Occupant"):Connect(function()
		local humanoid = seat.Occupant
		if not chassis.Parent then
			return
		end
		if humanoid then
			local player = Players:GetPlayerFromCharacter(humanoid.Parent)
			if player then
				pcall(function()
					chassis:SetNetworkOwner(player)
				end)
			end
		else
			pcall(function()
				chassis:SetNetworkOwnershipAuto()
			end)
		end
	end)
	table.insert(cars, car)
	return car
end

local function removeCar(car)
	for i, c in ipairs(cars) do
		if c == car then
			table.remove(cars, i)
			break
		end
	end
	if car.model then
		car.model:Destroy()
	end
end

local function flatCFrame(cf)
	local look = cf.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 0.01 then
		flat = Vector3.new(0, 0, -1)
	end
	return CFrame.lookAt(cf.Position, cf.Position + flat.Unit)
end

-- parked cars around the city
for _, marker in ipairs(spawns:GetChildren()) do
	if marker.Name == "Parked" then
		local base = flatCFrame(marker.CFrame) - Vector3.new(0, marker.Size.Y / 2, 0)
		buildCar(base, STYLES[rng:NextInteger(1, #STYLES)], PAINT[rng:NextInteger(1, #PAINT)], nil)
		task.wait()
	end
end

-- "Get a car" pads
for _, pad in ipairs(spawns:GetChildren()) do
	if pad.Name == "Pad" then
		local base = pad:FindFirstChild("Base")
		local point = pad:FindFirstChild("SpawnPoint")
		local p = base and base:FindFirstChildOfClass("ProximityPrompt")
		if p and point then
			local tag = Instance.new("BillboardGui")
			tag.Size = UDim2.fromOffset(180, 44)
			tag.StudsOffset = Vector3.new(0, 7, 0)
			tag.MaxDistance = 260
			tag.LightInfluence = 0
			local text = Instance.new("TextLabel")
			text.Size = UDim2.fromScale(1, 1)
			text.BackgroundTransparency = 1
			text.Font = Enum.Font.GothamBlack
			text.TextScaled = true
			text.TextColor3 = Color3.fromRGB(120, 230, 255)
			text.TextStrokeTransparency = 0.3
			text.Text = "GET A CAR"
			text.Parent = tag
			tag.Parent = base
			p.Triggered:Connect(function(player)
				local character = player.Character
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				if not humanoid or humanoid.Health <= 0 then
					return
				end
				if owned[player] then
					removeCar(owned[player])
					owned[player] = nil
				end
				local cf = flatCFrame(point.CFrame) - Vector3.new(0, point.Size.Y / 2, 0)
				local car = buildCar(cf, STYLES[rng:NextInteger(1, #STYLES)], PAINT[rng:NextInteger(1, #PAINT)], player)
				owned[player] = car
				task.wait(0.2)
				if humanoid.Health > 0 then
					humanoid.Sit = false
					car.seat:Sit(humanoid)
				end
			end)
		end
	end
end

Players.PlayerRemoving:Connect(function(player)
	if owned[player] then
		removeCar(owned[player])
		owned[player] = nil
	end
end)

-- driving: follow each VehicleSeat's throttle and steering
RunService.Heartbeat:Connect(function()
	for _, car in ipairs(cars) do
		local chassis, seat = car.chassis, car.seat
		if chassis.Parent then
			local throttle, steer = seat.ThrottleFloat, seat.SteerFloat
			local speed = chassis.AssemblyLinearVelocity:Dot(chassis.CFrame.LookVector)
			local target, torque = 0, COAST_TORQUE
			if throttle ~= 0 then
				if speed * throttle < -4 then
					torque = BRAKE_TORQUE -- pressing against the motion: brake first
				else
					torque = DRIVE_TORQUE
					target = throttle > 0 and car.style.top or -car.style.top * 0.45
				end
			end
			for _, m in ipairs(car.motors) do
				m.MotorMaxTorque = torque
				m.AngularVelocity = FORWARD * target / WHEEL_R
			end
			local maxAngle = 34 - 20 * math.clamp(math.abs(speed) / car.style.top, 0, 1)
			for _, s in ipairs(car.servos) do
				s.TargetAngle = STEER * steer * maxAngle
			end
		end
	end
end)

-- headlights at night, put overturned cars back on their wheels, return abandoned parked cars
while true do
	task.wait(1)
	local t = Lighting.ClockTime
	local night = t < 6.4 or t > 17.6
	for i = #cars, 1, -1 do
		local car = cars[i]
		local chassis = car.chassis
		if not chassis.Parent then
			table.remove(cars, i)
		else
			for _, lamp in ipairs(car.lamps) do
				lamp.Enabled = night
			end
			if chassis.CFrame.UpVector.Y < 0.3 then
				car.flipped = car.flipped + 1
			else
				car.flipped = 0
			end
			if car.flipped >= 3 then
				car.flipped = 0
				local pos = chassis.Position
				chassis.AssemblyLinearVelocity = Vector3.zero
				chassis.AssemblyAngularVelocity = Vector3.zero
				car.model:PivotTo(flatCFrame(CFrame.lookAt(pos, pos + chassis.CFrame.LookVector)) + Vector3.new(0, 5, 0))
			end
			if car.seat.Occupant or car.passenger.Occupant then
				car.idle = 0
			else
				car.idle = car.idle + 1
			end
			if not car.owner and car.idle > 120 and (chassis.Position - car.home.Position).Magnitude > 60 then
				car.idle = 0
				chassis.AssemblyLinearVelocity = Vector3.zero
				chassis.AssemblyAngularVelocity = Vector3.zero
				car.model:PivotTo(car.home * CFrame.new(0, WHEEL_R + 0.3, 0))
			end
		end
	end
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="Script" referent="RBX02BE2"><Properties>
<string name="Name">Coins</string>
<ProtectedString name="Source"><![CDATA[-- Glass coins all over the city. Walk or drive through one to collect it; it comes back
-- after a while. Your total shows on the leaderboard and is saved between visits.
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")

local RESPAWN = 25
local store = nil
pcall(function()
	store = DataStoreService:GetDataStore("GlassCityCoins")
end)

local function load(player, value)
	if not store then
		return
	end
	local ok, saved = pcall(function()
		return store:GetAsync("u" .. player.UserId)
	end)
	if ok and type(saved) == "number" then
		value.Value = saved
	end
end

local function save(player)
	local stats = player:FindFirstChild("leaderstats")
	local coins = stats and stats:FindFirstChild("Coins")
	if store and coins then
		pcall(function()
			store:SetAsync("u" .. player.UserId, coins.Value)
		end)
	end
end

Players.PlayerAdded:Connect(function(player)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local coins = Instance.new("IntValue")
	coins.Name = "Coins"
	coins.Parent = stats
	stats.Parent = player
	load(player, coins)
end)
Players.PlayerRemoving:Connect(save)
game:BindToClose(function()
	for _, player in ipairs(Players:GetPlayers()) do
		save(player)
	end
end)

-- who touched it: a character, or whoever is driving the car that hit it
local function playerFromHit(hit)
	local model = hit:FindFirstAncestorOfClass("Model")
	while model do
		local player = Players:GetPlayerFromCharacter(model)
		if player then
			return player
		end
		local seat = model:FindFirstChild("DriveSeat")
		if seat and seat.Occupant then
			return Players:GetPlayerFromCharacter(seat.Occupant.Parent)
		end
		model = model:FindFirstAncestorOfClass("Model")
	end
	return nil
end

for _, coin in ipairs(workspace.Coins:GetChildren()) do
	if coin:IsA("BasePart") then
		local taken = false
		coin.Touched:Connect(function(hit)
			if taken then
				return
			end
			local player = playerFromHit(hit)
			local stats = player and player:FindFirstChild("leaderstats")
			if not stats then
				return
			end
			taken = true
			stats.Coins.Value = stats.Coins.Value + 1
			coin.Transparency = 1
			task.delay(RESPAWN, function()
				coin.Transparency = 0
				taken = false
			end)
		end)
	end
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="Script" referent="RBX02BE3"><Properties>
<string name="Name">DayNight</string>
<ProtectedString name="Source"><![CDATA[-- A full day passes in MINUTES_PER_DAY real minutes. At dusk the street lights come on
-- and the city's windows light up; at dawn they go off again.
local Lighting = game:GetService("Lighting")

local MINUTES_PER_DAY = 16
local WARM = Color3.fromRGB(196, 158, 104)

local lamps, windows = {}, {}
for _, d in ipairs(workspace:GetDescendants()) do
	if d:IsA("Light") and d.Name == "NightLight" then
		table.insert(lamps, d)
	elseif d:IsA("BasePart") and d.Name == "Lit window" then
		table.insert(windows, { part = d, color = d.Color, material = d.Material })
	end
end

local wasNight = nil
while true do
	local dt = task.wait(0.1)
	Lighting.ClockTime = (Lighting.ClockTime + dt * 24 / (MINUTES_PER_DAY * 60)) % 24
	local t = Lighting.ClockTime
	local night = t < 6.3 or t > 17.8
	if night ~= wasNight then
		wasNight = night
		for _, lamp in ipairs(lamps) do
			lamp.Enabled = night
			if lamp.Parent:IsA("BasePart") then
				lamp.Parent.Material = night and Enum.Material.Neon or Enum.Material.SmoothPlastic
			end
		end
		for i, w in ipairs(windows) do
			w.part.Material = night and Enum.Material.Neon or w.material
			w.part.Color = night and WARM:Lerp(w.color, 0.3) or w.color
			if i % 250 == 0 then
				task.wait()
			end
		end
	end
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="Script" referent="RBX02BE4"><Properties>
<string name="Name">Doors</string>
<ProtectedString name="Source"><![CDATA[-- Automatic sliding doors, in the mall and the VAYU hotel: they open when a player or a
-- shopper comes close and close again when nobody is near. Each door is a Model named
-- AutoDoor with panels L and R and a NumberValue "Slide" (how far each panel moves, in studs).
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local RANGE = 14
local INFO = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local doors = {}
for _, model in ipairs(workspace:GetDescendants()) do
	local l, r, slide = model:FindFirstChild("L"), model:FindFirstChild("R"), model:FindFirstChild("Slide")
	if model:IsA("Model") and model.Name == "AutoDoor" and l and r and slide then
		table.insert(doors, {
			l = l,
			r = r,
			lClosed = l.CFrame,
			rClosed = r.CFrame,
			lOpen = l.CFrame * CFrame.new(-slide.Value, 0, 0),
			rOpen = r.CFrame * CFrame.new(slide.Value, 0, 0),
			centre = (l.Position + r.Position) / 2,
			open = false,
		})
	end
end

local function walkers()
	local list = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root then
			table.insert(list, root.Position)
		end
	end
	local shoppers = workspace:FindFirstChild("Shoppers")
	if shoppers then
		for _, npc in ipairs(shoppers:GetChildren()) do
			local root = npc:FindFirstChild("HumanoidRootPart")
			if root then
				table.insert(list, root.Position)
			end
		end
	end
	return list
end

while true do
	local here = walkers()
	for _, door in ipairs(doors) do
		local near = false
		for _, p in ipairs(here) do
			if (p - door.centre).Magnitude < RANGE then
				near = true
				break
			end
		end
		if near ~= door.open then
			door.open = near
			TweenService:Create(door.l, INFO, { CFrame = near and door.lOpen or door.lClosed }):Play()
			TweenService:Create(door.r, INFO, { CFrame = near and door.rOpen or door.rClosed }):Play()
		end
	end
	task.wait(0.15)
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="Script" referent="RBX02BE5"><Properties>
<string name="Name">Escalators</string>
<ProtectedString name="Source"><![CDATA[-- Escalator treads are anchored parts with a surface velocity, so anyone standing
-- on one is carried up the slope (you can still walk down against it).
local SPEED = 5

for _, part in ipairs(workspace.Mall.Escalators:GetDescendants()) do
	if part:IsA("BasePart") and part.Name == "Tread" then
		part.AssemblyLinearVelocity = part.CFrame.XVector * SPEED
	end
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="Script" referent="RBX02BE6"><Properties>
<string name="Name">Lift</string>
<ProtectedString name="Source"><![CDATA[-- The glass lift beside the shops. Click a floor button inside the car, or the
-- call button (or prompt) on any landing. Landing doors open only when the car is there.
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local STOPS = { 0.105, 21, 31.5, 42, 52.5 } -- floor tops in studs: GF, 1F, 2F, 3F, 4F
local SPEED = 9
local INFO = TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)

local lift = workspace.Mall.Lift
local car = lift.Car
local floor = car:WaitForChild("Floor")

local landings = {}
for i = 1, #STOPS do
	local door = lift.Landings:FindFirstChild("Door" .. i)
	if door then
		local l, r, slide = door.L, door.R, door.Slide.Value
		landings[i] = {
			l = l,
			r = r,
			lClosed = l.CFrame,
			rClosed = r.CFrame,
			lOpen = l.CFrame * CFrame.new(-slide, 0, 0),
			rOpen = r.CFrame * CFrame.new(slide, 0, 0),
		}
	end
end

local function setDoors(i, open)
	local d = landings[i]
	if not d then
		return
	end
	TweenService:Create(d.l, INFO, { CFrame = open and d.lOpen or d.lClosed }):Play()
	TweenService:Create(d.r, INFO, { CFrame = open and d.rOpen or d.rClosed }):Play()
end

local current = 1
local moving = false
local queue = {}

local function request(i)
	if i == current and not moving then
		setDoors(current, true)
		return
	end
	for _, q in ipairs(queue) do
		if q == i then
			return
		end
	end
	table.insert(queue, i)
end

local function topOfFloor()
	return floor.Position.Y + floor.Size.Y / 2
end

local function travel(target)
	setDoors(current, false)
	task.wait(1)
	moving = true
	local goal = STOPS[target]
	while true do
		local dt = RunService.Heartbeat:Wait()
		local remaining = goal - topOfFloor()
		if math.abs(remaining) < 0.02 then
			break
		end
		local dir = remaining > 0 and 1 or -1
		local step = dir * math.min(SPEED * dt, math.abs(remaining))
		floor.AssemblyLinearVelocity = Vector3.new(0, dir * SPEED, 0)
		car:PivotTo(car:GetPivot() + Vector3.new(0, step, 0))
	end
	floor.AssemblyLinearVelocity = Vector3.zero
	moving = false
	current = target
end

for _, button in ipairs(car:GetChildren()) do
	local n = tonumber(string.match(button.Name, "^Button(%d)$"))
	local click = button:FindFirstChildOfClass("ClickDetector")
	if n and click then
		click.MouseClick:Connect(function()
			request(n)
		end)
	end
end

for i = 1, #STOPS do
	local call = lift.Landings:FindFirstChild("Call" .. i)
	if call then
		local click = call:FindFirstChildOfClass("ClickDetector")
		local prompt = call:FindFirstChildOfClass("ProximityPrompt")
		if click then
			click.MouseClick:Connect(function()
				request(i)
			end)
		end
		if prompt then
			prompt.Triggered:Connect(function()
				request(i)
			end)
		end
	end
end

setDoors(current, true)
while true do
	if #queue > 0 then
		local target = table.remove(queue, 1)
		if target ~= current then
			travel(target)
		end
		setDoors(current, true)
		task.wait(4)
	else
		task.wait(0.2)
	end
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="Script" referent="RBX02BE7"><Properties>
<string name="Name">Portals</string>
<ProtectedString name="Source"><![CDATA[-- Glowing pads that take you somewhere: the VAYU lobby to its sky pool and back, and the
-- stunt park floor to the top of the mega ramp. Each pad names its partner in "Target".
local folder = workspace:WaitForChild("Portals")

for _, pad in ipairs(folder:GetChildren()) do
	local target = pad:FindFirstChild("Target")
	local label = pad:FindFirstChild("Label")
	if pad:IsA("BasePart") and target then
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = label and label.Value or "Go"
		prompt.ObjectText = "Portal"
		prompt.HoldDuration = 0.3
		prompt.MaxActivationDistance = 10
		prompt.RequiresLineOfSight = false
		prompt.Parent = pad
		local tag = Instance.new("BillboardGui")
		tag.Size = UDim2.fromOffset(220, 40)
		tag.StudsOffset = Vector3.new(0, 5, 0)
		tag.MaxDistance = 150
		tag.LightInfluence = 0
		local text = Instance.new("TextLabel")
		text.Size = UDim2.fromScale(1, 1)
		text.BackgroundTransparency = 1
		text.Font = Enum.Font.GothamBold
		text.TextScaled = true
		text.TextColor3 = Color3.fromRGB(225, 190, 255)
		text.TextStrokeTransparency = 0.4
		text.Text = prompt.ActionText
		text.Parent = tag
		tag.Parent = pad
		prompt.Triggered:Connect(function(player)
			local character = player.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			local dest = folder:FindFirstChild(target.Value)
			if humanoid and humanoid.Health > 0 and dest then
				humanoid.Sit = false
				character:PivotTo(CFrame.new(dest.Position + Vector3.new(0, 4, 0)))
			end
		end)
	end
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="Script" referent="RBX02BE8"><Properties>
<string name="Name">Shoppers</string>
<ProtectedString name="Source"><![CDATA[-- Shoppers arrive from the street, walk into the mall through the automatic doors,
-- visit one to three places (shops, food court, arcade, cinemas, terrace) and walk
-- back out. Each leaves and a new one arrives, so the mall always has some life.
local Players = game:GetService("Players")
local PathfindingService = game:GetService("PathfindingService")

local COUNT = 14
local street = workspace.Waypoints.Street:GetChildren()
local inside = workspace.Waypoints.Inside:GetChildren()
local folder = workspace:FindFirstChild("Shoppers")
local rng = Random.new()

local SKIN = {
	Color3.fromRGB(255, 220, 190), Color3.fromRGB(234, 184, 146), Color3.fromRGB(198, 140, 100),
	Color3.fromRGB(160, 105, 72), Color3.fromRGB(120, 78, 52), Color3.fromRGB(86, 58, 40),
}
local TOPS = {
	Color3.fromRGB(230, 90, 70), Color3.fromRGB(60, 120, 200), Color3.fromRGB(245, 245, 240),
	Color3.fromRGB(40, 44, 52), Color3.fromRGB(240, 190, 60), Color3.fromRGB(90, 170, 120),
	Color3.fromRGB(200, 120, 200), Color3.fromRGB(120, 200, 230),
}
local BOTTOMS = {
	Color3.fromRGB(40, 50, 80), Color3.fromRGB(30, 30, 34), Color3.fromRGB(150, 130, 100),
	Color3.fromRGB(90, 90, 96), Color3.fromRGB(60, 80, 120),
}

local function pick(list)
	return list[rng:NextInteger(1, #list)]
end

local function simpleBody(colour)
	local model = Instance.new("Model")
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2, 5, 1.4)
	root.Color = colour
	root.Parent = model
	local humanoid = Instance.new("Humanoid")
	humanoid.RigType = Enum.HumanoidRigType.R15
	humanoid.HipHeight = 0
	humanoid.Parent = model
	model.PrimaryPart = root
	return model
end

local function makeShopper(at)
	local desc = Instance.new("HumanoidDescription")
	local skin, top, bottom = pick(SKIN), pick(TOPS), pick(BOTTOMS)
	desc.HeadColor = skin
	desc.LeftArmColor = skin
	desc.RightArmColor = skin
	desc.TorsoColor = top
	desc.LeftLegColor = bottom
	desc.RightLegColor = bottom
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		model = simpleBody(top)
	end
	model.Name = "Shopper"
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	humanoid.WalkSpeed = rng:NextNumber(7, 10)
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	model:PivotTo(CFrame.new(at.Position + Vector3.new(0, 3.2, 0)))
	model.Parent = folder
	local root = model:FindFirstChild("HumanoidRootPart")
	if root then
		pcall(function()
			root:SetNetworkOwner(nil)
		end)
	end
	return model, humanoid
end

local function walkTo(model, humanoid, target)
	local root = model:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local path = PathfindingService:CreatePath({
		AgentRadius = 1.5,
		AgentHeight = 5,
		AgentCanJump = false,
		WaypointSpacing = 5,
		Costs = { Door = 1 },
	})
	local points = {}
	local ok = pcall(function()
		path:ComputeAsync(root.Position, target)
	end)
	if ok and path.Status == Enum.PathStatus.Success then
		for _, w in ipairs(path:GetWaypoints()) do
			table.insert(points, w.Position)
		end
	else
		points = { target }
	end
	for _, p in ipairs(points) do
		if not model.Parent or humanoid.Health <= 0 then
			return
		end
		humanoid:MoveTo(p)
		if not humanoid.MoveToFinished:Wait() then
			humanoid:MoveTo(p)
			if not humanoid.MoveToFinished:Wait() then
				return
			end
		end
	end
end

local function life()
	while true do
		local model, humanoid = makeShopper(pick(street))
		for _ = 1, rng:NextInteger(1, 3) do
			walkTo(model, humanoid, pick(inside).Position)
			task.wait(rng:NextNumber(3, 9))
		end
		walkTo(model, humanoid, pick(street).Position)
		model:Destroy()
		task.wait(rng:NextNumber(2, 8))
	end
end

for _ = 1, COUNT do
	task.spawn(life)
	task.wait(1.5)
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="Script" referent="RBX02BE9"><Properties>
<string name="Name">Signage</string>
<ProtectedString name="Source"><![CDATA[-- Builds every sign in the place from the values stored on its part:
--   SignText (StringValue)  what it says
--   Face     (StringValue)  which face of the part it is drawn on (default Back)
--   Style    (StringValue)  fascia | led | screen | directory | button
--   Accent   (Color3Value)  second colour for animated signs
-- Gradients named "Anim" are animated on each player's screen by ClientFX.
local function gradient(frame, c0, c1)
	local g = Instance.new("UIGradient")
	g.Name = "Anim"
	g.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, c0),
		ColorSequenceKeypoint.new(0.5, c1),
		ColorSequenceKeypoint.new(1, c0),
	})
	g.Parent = frame
end

local function build(part)
	local text = part:FindFirstChild("SignText")
	local face = part:FindFirstChild("Face")
	local style = part:FindFirstChild("Style")
	local accent = part:FindFirstChild("Accent")
	local kind = style and style.Value or "fascia"

	local gui = Instance.new("SurfaceGui")
	gui.Name = "Sign"
	gui.Face = Enum.NormalId[face and face.Value or "Back"]
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = kind == "button" and 80 or 30
	gui.LightInfluence = 0
	gui.Brightness = kind == "screen" and 2 or 1.5

	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1, 1)
	bg.BorderSizePixel = 0
	bg.BackgroundTransparency = 1
	bg.Parent = gui

	if kind == "led" or kind == "screen" then
		bg.BackgroundTransparency = 0
		bg.BackgroundColor3 = Color3.new(1, 1, 1)
		local base = kind == "led" and Color3.fromRGB(16, 30, 120) or Color3.fromRGB(26, 18, 54)
		gradient(bg, base, accent and accent.Value or Color3.fromRGB(210, 50, 170))
	elseif kind == "directory" then
		bg.BackgroundTransparency = 0.05
		bg.BackgroundColor3 = Color3.fromRGB(18, 22, 26)
	elseif kind == "button" then
		bg.BackgroundTransparency = 0
		bg.BackgroundColor3 = Color3.fromRGB(30, 34, 40)
	end

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.Font = kind == "directory" and Enum.Font.Gotham or Enum.Font.GothamBold
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Text = text.Value
	if kind == "directory" then
		label.Size = UDim2.fromScale(0.86, 0.86)
		label.Position = UDim2.fromScale(0.07, 0.07)
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.TextYAlignment = Enum.TextYAlignment.Top
	elseif kind == "screen" then
		label.Size = UDim2.fromScale(0.8, 0.5)
		label.Position = UDim2.fromScale(0.1, 0.25)
	else
		label.Size = UDim2.fromScale(0.9, 0.72)
		label.Position = UDim2.fromScale(0.05, 0.14)
	end
	label.Parent = bg
	gui.Parent = part
end

for _, d in ipairs(workspace:GetDescendants()) do
	if d:IsA("BasePart") and d:FindFirstChild("SignText") then
		build(d)
	end
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="Script" referent="RBX02BEA"><Properties>
<string name="Name">Terrain</string>
<ProtectedString name="Source"><![CDATA[-- Terrain that a place file of parts can't hold: the bay east of the highway with its
-- beach, the lake in Central Park and the grassy hills round the city.
local terrain = workspace.Terrain
local T = {
	water = { { 2342.6179, -9.8, 17.9795, 2100, 15.4, 3990 } },
	sand = { { 1201.6179, -10.7625, 17.9795, 182, 20.475, 3990 }, { 2342.6179, -24.5, 17.9795, 2100, 14, 3990 } },
	wedges = { { 1380.1179, -9.0125, 17.9795, 175, 16.975, 3990 } },
	lakeBed = { 305.6179, -12.95, -27.5205, 154, 2.1, 147 },
	lake = { 305.6179, -6.65, -27.5205, 154, 10.5, 147 },
	hills = { { -1715.475, -97.4647, 1872.9795, 177.2086 }, { -1594.5972, -103.1714, 1592.9795, 187.5843 }, { -1537.2588, -78.5375, 1312.9795, 142.7955 }, { -1333.5917, -90.3048, 1032.9795, 164.1905 }, { -1365.1019, -85.0239, 752.9795, 154.5889 }, { -1673.757, -75.8269, 472.9795, 137.8671 }, { -1667.7734, -106.5846, 192.9795, 193.7903 }, { -1404.1271, -89.0411, -87.0205, 161.893 }, { -1604.9223, -70.7409, -367.0205, 128.6199 }, { -1533.4138, -106.103, -647.0205, 192.9145 }, { -1701.3973, -93.5175, -927.0205, 170.0318 }, { -1671.3377, -86.4743, -1207.0205, 157.2261 }, { -1535.9871, -69.7904, -1487.0205, 126.8916 }, { -1534.4291, -109.0072, -1767.0205, 198.1949 }, { -1577.3821, -112.0747, -1792.8039, 203.7723 }, { -1577.3821, -86.2334, 1751.2729, 156.7881 }, { -1297.3821, -80.2624, -1673.6471, 145.9316 }, { -1297.3821, -95.9695, 1916.8733, 174.49 }, { -1017.3821, -86.2106, -1545.0197, 156.7465 }, { -1017.3821, -84.0631, 1734.6314, 152.842 }, { -737.3821, -106.2358, -1526.3878, 193.156 }, { -737.3821, -102.6107, 1733.8125, 186.5649 }, { -457.3821, -112.3202, -1597.5213, 204.2185 }, { -457.3821, -84.4825, 1778.9831, 153.6045 }, { -177.3821, -89.7797, -1679.2966, 163.2358 }, { -177.3821, -76.7658, 1595.155, 139.5742 }, { 102.6179, -81.393, -1715.6837, 147.9874 }, { 102.6179, -112.0292, 1652.4941, 203.6895 }, { 382.6179, -108.6191, -1561.1983, 197.4892 }, { 382.6179, -113.0502, 1744.5302, 205.5458 }, { 662.6179, -114.9088, -1838.8739, 208.9251 }, { 662.6179, -86.7276, 1927.3478, 157.6866 }, { 942.6179, -105.2494, -1700.6811, 191.3625 }, { 942.6179, -110.7953, 1693.4454, 201.4459 } },
	rocks = { { 1362.6179, -3.5, -437.0205, 17.5 }, { 1453.6179, -5.25, 857.9795, 24.5 }, { 1275.1179, -1.75, 1242.9795, 21 }, { 1537.6179, -7, -787.0205, 31.5 } },
} -- boxes are { centre x, y, z, size x, y, z } in studs; balls { x, y, z, radius }

terrain:SetMaterialColor(Enum.Material.Grass, Color3.fromRGB(96, 140, 66))
terrain:SetMaterialColor(Enum.Material.Sand, Color3.fromRGB(226, 206, 160))
terrain.WaterColor = Color3.fromRGB(28, 116, 140)
terrain.WaterTransparency = 0.55
terrain.WaterReflectance = 0.5
terrain.WaterWaveSize = 0.12
terrain.WaterWaveSpeed = 8

-- big fills go in tiles of at most 512 studs
local function block(b, material)
	local nx, nz = math.ceil(b[4] / 512), math.ceil(b[6] / 512)
	local tx, tz = b[4] / nx, b[6] / nz
	for i = 0, nx - 1 do
		for j = 0, nz - 1 do
			local px = b[1] - b[4] / 2 + tx * (i + 0.5)
			local pz = b[3] - b[6] / 2 + tz * (j + 0.5)
			terrain:FillBlock(CFrame.new(px, b[2], pz), Vector3.new(tx, b[5], tz), material)
		end
		task.wait()
	end
end

-- the lake first, then let the rowing boats float on it
block(T.lakeBed, Enum.Material.Mud)
block(T.lake, Enum.Material.Water)
local floating = workspace.City.Park:FindFirstChild("Floating")
if floating then
	for _, boat in ipairs(floating:GetChildren()) do
		if boat:IsA("BasePart") then
			boat.Anchored = false
		end
	end
end

for _, b in ipairs(T.water) do
	block(b, Enum.Material.Water)
end
for _, b in ipairs(T.sand) do
	block(b, Enum.Material.Sand)
end
-- the beach shelving into the sea: a wedge whose high edge faces the city (west)
for _, b in ipairs(T.wedges) do
	local nz = math.ceil(b[6] / 512)
	local tz = b[6] / nz
	for j = 0, nz - 1 do
		local c = Vector3.new(b[1], b[2], b[3] - b[6] / 2 + tz * (j + 0.5))
		terrain:FillWedge(CFrame.lookAt(c, c + Vector3.new(1, 0, 0)), Vector3.new(tz, b[5], b[4]), Enum.Material.Sand)
	end
end
for _, h in ipairs(T.hills) do
	terrain:FillBall(Vector3.new(h[1], h[2], h[3]), h[4], Enum.Material.Grass)
	task.wait()
end
for _, r in ipairs(T.rocks) do
	terrain:FillBall(Vector3.new(r[1], r[2], r[3]), r[4], Enum.Material.Rock)
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="Script" referent="RBX02BEB"><Properties>
<string name="Name">Traffic</string>
<ProtectedString name="Source"><![CDATA[-- City traffic: cars loop round the ring highway and run up and down the boulevard, two
-- avenues and a street. They keep left, as in Bengaluru, and wrap round at the ends.
local RunService = game:GetService("RunService")

local PATHS = {
	{ pts = { Vector3.new(998.6179, 0, 980.4795), Vector3.new(1017.3694, 0, 976.7496), Vector3.new(1033.2661, 0, 966.1277), Vector3.new(1043.888, 0, 950.231), Vector3.new(1047.6179, 0, 931.4795), Vector3.new(1047.6179, 0, -895.5205), Vector3.new(1043.888, 0, -914.272), Vector3.new(1033.2661, 0, -930.1687), Vector3.new(1017.3694, 0, -940.7906), Vector3.new(998.6179, 0, -944.5205), Vector3.new(-705.8821, 0, -944.5205), Vector3.new(-724.6336, 0, -940.7906), Vector3.new(-740.5303, 0, -930.1687), Vector3.new(-751.1522, 0, -914.272), Vector3.new(-754.8821, 0, -895.5205), Vector3.new(-754.8821, 0, 931.4795), Vector3.new(-751.1522, 0, 950.231), Vector3.new(-740.5303, 0, 966.1277), Vector3.new(-724.6336, 0, 976.7496), Vector3.new(-705.8821, 0, 980.4795) }, loop = true, lanes = { { -8.4, 1 }, { -23.1, 1 }, { 8.4, -1 }, { 23.1, -1 } }, count = 12, speed = 66 },
	{ pts = { Vector3.new(-760.1064, 0, -229.0618), Vector3.new(1045.8936, 0, 620.7024) }, loop = false, lanes = { { -24.675, 1 }, { -12.775, 1 }, { 11.725, -1 }, { 23.625, -1 } }, count = 6, speed = 46 },
	{ pts = { Vector3.new(460.6679, 0, 980.4795), Vector3.new(460.6679, 0, -944.5205) }, loop = false, lanes = { { -6.3, 1 }, { 6.3, -1 } }, count = 4, speed = 38 },
	{ pts = { Vector3.new(-155.3321, 0, 980.4795), Vector3.new(-155.3321, 0, -944.5205) }, loop = false, lanes = { { -6.3, 1 }, { 6.3, -1 } }, count = 4, speed = 38 },
	{ pts = { Vector3.new(-754.8821, 0, -178.0205), Vector3.new(1047.6179, 0, -178.0205) }, loop = false, lanes = { { -6.3, 1 }, { 6.3, -1 } }, count = 4, speed = 38 }
} -- points in studs, loop?, lanes { offset right of the path, direction }, cars, speed
local CAR_Y = 2.275
local UP = Vector3.new(0, 1, 0)

for _, path in ipairs(PATHS) do
	if path.loop then
		table.insert(path.pts, path.pts[1])
	end
	path.cum = { 0 }
	for i = 2, #path.pts do
		path.cum[i] = path.cum[i - 1] + (path.pts[i] - path.pts[i - 1]).Magnitude
	end
	path.length = path.cum[#path.cum]
end

-- position and direction at distance s along a path
local function sample(path, s)
	local pts, cum = path.pts, path.cum
	local lo, hi = 1, #pts
	while hi - lo > 1 do
		local mid = (lo + hi) // 2
		if cum[mid] <= s then
			lo = mid
		else
			hi = mid
		end
	end
	local span = cum[hi] - cum[lo]
	local a = span > 0 and (s - cum[lo]) / span or 0
	return pts[lo]:Lerp(pts[hi], a), (pts[hi] - pts[lo]).Unit
end

local rng = Random.new(3)
local models = workspace.Site.Traffic:GetChildren()
local cars = {}
for _, path in ipairs(PATHS) do
	for i = 1, path.count do
		local model = table.remove(models)
		if not model then
			break
		end
		local lane = path.lanes[(i - 1) % #path.lanes + 1]
		table.insert(cars, {
			model = model,
			path = path,
			s = rng:NextNumber(0, path.length),
			offset = lane[1],
			dir = lane[2],
			speed = path.speed * rng:NextNumber(0.85, 1.1),
		})
	end
end

RunService.Heartbeat:Connect(function(dt)
	for _, car in ipairs(cars) do
		local path = car.path
		car.s = (car.s + car.dir * car.speed * dt) % path.length
		local pos, dir = sample(path, car.s)
		pos = pos + dir:Cross(UP) * car.offset + Vector3.new(0, CAR_Y, 0)
		car.model:PivotTo(CFrame.lookAt(pos, pos + dir * car.dir))
	end
end)
]]></ProtectedString>
</Properties>
</Item>
<Item class="Script" referent="RBX02BEC"><Properties>
<string name="Name">Travel</string>
<ProtectedString name="Source"><![CDATA[-- Moves a player to a place picked in the Travel menu.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local PLACES = {
	["Glass Mall"] = Vector3.new(-4.4821, 0.35, 34.0795),
	["Mall car park"] = Vector3.new(-112.6321, 0.35, 372.5295),
	["VAYU Hotel lobby"] = Vector3.new(101.5679, 0.175, -349.5205),
	["VAYU sky pool"] = Vector3.new(180.3179, 152.95, -358.2705),
	["Downtown plaza"] = Vector3.new(541.8679, 0.455, -52.0205),
	["Central Park"] = Vector3.new(305.6179, 0.21, -123.7705),
	["Stunt park"] = Vector3.new(660.8679, 0.35, -232.2705),
	["Mega ramp top"] = Vector3.new(935.6179, 56, -577.0205),
	["Glass Bay beach"] = Vector3.new(1098.3679, 0.42, 127.5295),
	["Pier"] = Vector3.new(1362.6179, 5.6, 14.4795),
	["Suburbs"] = Vector3.new(-229.8821, 0, -430.0205),
	["Midtown"] = Vector3.new(191.1679, 0.35, 474.0295),
	["Uptown"] = Vector3.new(128.1679, 0.35, -727.5205)
} -- name -> position in studs
local event = ReplicatedStorage:WaitForChild("Travel")
local last = {}

event.OnServerEvent:Connect(function(player, name)
	local pos = type(name) == "string" and PLACES[name]
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not pos or not humanoid or humanoid.Health <= 0 then
		return
	end
	if last[player] and os.clock() - last[player] < 2 then
		return
	end
	last[player] = os.clock()
	humanoid.Sit = false
	task.wait(0.15)
	pcall(function()
		player:RequestStreamAroundAsync(pos)
	end)
	character:PivotTo(CFrame.new(pos + Vector3.new(0, 4, 0)))
end)

Players.PlayerRemoving:Connect(function(player)
	last[player] = nil
end)
]]></ProtectedString>
</Properties>
</Item>
</Item>
