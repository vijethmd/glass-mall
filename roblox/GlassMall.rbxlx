<Item class="LocalScript" referent="RBX08112"><Properties>
<string name="Name">CarHUD</string>
<ProtectedString name="Source"><![CDATA[-- Speedometer and driving hints while you sit in a car's driver seat.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local KMH = 0.2857 * 3.6 -- studs/s -> km/h at 3.5 studs per metre

local gui = Instance.new("ScreenGui")
gui.Name = "CarHUD"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local panel = Instance.new("Frame")
panel.AnchorPoint = Vector2.new(1, 1)
panel.Size = UDim2.new(0, 210, 0, 92)
panel.Position = UDim2.new(1, -18, 1, -18)
panel.BackgroundColor3 = Color3.fromRGB(14, 20, 24)
panel.BackgroundTransparency = 0.15
panel.Visible = false
panel.Parent = gui
local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = panel

local speed = Instance.new("TextLabel")
speed.Size = UDim2.new(1, -24, 0, 50)
speed.Position = UDim2.new(0, 12, 0, 6)
speed.BackgroundTransparency = 1
speed.Font = Enum.Font.GothamBlack
speed.TextSize = 40
speed.TextXAlignment = Enum.TextXAlignment.Left
speed.TextColor3 = Color3.fromRGB(120, 225, 245)
speed.Parent = panel

local unit = Instance.new("TextLabel")
unit.Size = UDim2.new(0, 60, 0, 50)
unit.Position = UDim2.new(1, -72, 0, 6)
unit.BackgroundTransparency = 1
unit.Font = Enum.Font.GothamMedium
unit.TextSize = 16
unit.TextXAlignment = Enum.TextXAlignment.Right
unit.TextColor3 = Color3.fromRGB(200, 210, 214)
unit.Text = "km/h"
unit.Parent = panel

local hint = Instance.new("TextLabel")
hint.Size = UDim2.new(1, -24, 0, 30)
hint.Position = UDim2.new(0, 12, 0, 56)
hint.BackgroundTransparency = 1
hint.Font = Enum.Font.Gotham
hint.TextSize = 13
hint.TextXAlignment = Enum.TextXAlignment.Left
hint.TextColor3 = Color3.fromRGB(200, 210, 214)
hint.Text = "W/S drive  ·  A/D steer  ·  Space get out"
hint.Parent = panel

RunService.RenderStepped:Connect(function()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local seat = humanoid and humanoid.SeatPart
	if seat and seat:IsA("VehicleSeat") then
		panel.Visible = true
		speed.Text = tostring(math.floor(seat.AssemblyLinearVelocity.Magnitude * KMH + 0.5))
	else
		panel.Visible = false
	end
end)
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBX08113"><Properties>
<string name="Name">ClientFX</string>
<ProtectedString name="Source"><![CDATA[-- Animates the LED walls, cinema screens and arcade marquees, spins the coins and the car
-- showroom turntables, flashes the sky club's dance floor and makes trampolines bounce, on
-- each player's screen.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local DANCE = {
	Color3.fromRGB(255, 60, 160),
	Color3.fromRGB(60, 200, 255),
	Color3.fromRGB(255, 200, 40),
	Color3.fromRGB(140, 80, 255),
	Color3.fromRGB(60, 255, 140),
}

local coins = workspace:WaitForChild("Coins")
local home = setmetatable({}, { __mode = "k" }) -- each coin's resting position

local gradients, spins, tiles = {}, {}, {}

local function bounce(hit)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and hit:IsDescendantOf(character) and root.AssemblyLinearVelocity.Y < 30 then
		local v = root.AssemblyLinearVelocity
		root.AssemblyLinearVelocity = Vector3.new(v.X, 78, v.Z)
	end
end

local function track(d)
	if d:IsA("UIGradient") and d.Name == "Anim" then
		table.insert(gradients, d)
	elseif d:IsA("Model") and d.Name == "Spin" then
		table.insert(spins, d)
	elseif d:IsA("BasePart") and d.Name == "DanceTile" then
		table.insert(tiles, d)
	elseif d:IsA("BasePart") and d.Name == "Trampoline" then
		d.Touched:Connect(bounce)
	end
end
for _, d in ipairs(workspace:GetDescendants()) do
	track(d)
end
workspace.DescendantAdded:Connect(track)

local t = 0
RunService.RenderStepped:Connect(function(dt)
	t = t + dt
	for i = #gradients, 1, -1 do
		local g = gradients[i]
		if g.Parent then
			g.Rotation = (t * 18 + i * 40) % 360
			g.Offset = Vector2.new(math.sin(t * 0.5 + i) * 0.4, 0)
		else
			table.remove(gradients, i)
		end
	end
	for i = #spins, 1, -1 do
		local m = spins[i]
		local table_ = m.Parent and m:FindFirstChild("Turntable")
		if table_ then
			local c = table_.Position
			m:PivotTo(CFrame.new(c) * CFrame.Angles(0, dt * 0.35, 0) * CFrame.new(-c) * m:GetPivot())
		elseif not m.Parent then
			table.remove(spins, i)
		end
	end
	for i, coin in ipairs(coins:GetChildren()) do
		local p = home[coin]
		if not p then
			p = coin.Position
			home[coin] = p
		end
		coin.CFrame = CFrame.new(p + Vector3.new(0, math.sin(t * 2 + i) * 0.4, 0)) * CFrame.Angles(0, t * 2.5 + i, 0)
	end
end)

task.spawn(function()
	while true do
		for i = #tiles, 1, -1 do
			local tile = tiles[i]
			if tile.Parent then
				tile.Color = DANCE[math.random(#DANCE)]
			else
				table.remove(tiles, i)
			end
		end
		task.wait(0.45)
	end
end)
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBX08114"><Properties>
<string name="Name">Elevators</string>
<ProtectedString name="Source"><![CDATA[-- Draws every lift car at the height the server's timetable gives (Elevators.server), slides
-- the car and landing doors, carries you with the car when you stand in it, rings the chime,
-- plays the lift music, lights the floor indicators and shows a floor panel while you ride.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Motion = require(ReplicatedStorage:WaitForChild("ElevatorMotion"))
local remote = ReplicatedStorage:WaitForChild("ElevatorRequest")

local player = Players.LocalPlayer
local DOOR_TIME = 1.0
local NEAR = 700 -- studs; lifts further than this from the camera are left as they are
local SOUND = {
	Chime = { "rbxassetid://9114302200", 0.8 },
	Doors = { "rbxassetid://9114305596", 0.35 },
	Music = { "rbxassetid://1841647093", 0.28 },
}
local ACCENT = Color3.fromRGB(120, 225, 245)

local lifts = {}

local function root()
	local c = player.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

-- ------------------------------------------------------------------ one lift
local function readStops(model)
	local folder = model:WaitForChild("Stops")
	local stops = {}
	for i = 1, #folder:GetChildren() do
		local v = folder:FindFirstChild(tostring(i))
		if not v then
			break
		end
		local label, title = v:FindFirstChild("Label"), v:FindFirstChild("Title")
		stops[i] = { y = v.Value, label = label and label.Value or tostring(i), title = title and title.Value or "" }
	end
	return stops
end

local function addLift(model)
	if lifts[model] then
		return
	end
	local stops = readStops(model)
	if #stops < 2 then
		return
	end
	local building = model:FindFirstChild("Building")
	local speed = model:FindFirstChild("MaxSpeed")
	local e = {
		model = model,
		stops = stops,
		name = building and building.Value or "Lift",
		vmax = speed and speed.Value or 14,
		y0 = stops[1].y,
		applied = stops[1].y,
		doorF = -1,
		landing = {},
		landingFloor = nil,
		pending = {},
		anchor = nil,
		active = false,
	}
	local function read()
		e.from = model:GetAttribute("From") or e.y0
		e.to = model:GetAttribute("To") or e.y0
		e.start = model:GetAttribute("Start") or 0
		e.plan = Motion.plan(e.from, e.to, e.vmax)
		e.floor = model:GetAttribute("Floor") or 1
		e.target = model:GetAttribute("Target") or e.floor
		e.doorOpen = model:GetAttribute("DoorOpen") or false
		e.doorT = model:GetAttribute("DoorT") or 0
	end
	read()
	model.AttributeChanged:Connect(function(name)
		read()
		if not e.car or not e.active then
			return
		end
		if name == "Arrivals" and e.sounds then
			e.sounds.Chime:Play()
			e.pending[e.floor] = nil
		elseif name == "DoorOpen" and e.sounds then
			e.sounds.Doors:Play()
		end
	end)
	lifts[model] = e
end

local function attachCar(e, car)
	e.car = car
	e.carFloor = nil
	e.sounds = nil
	e.doorRel = {}
	if not car then
		return
	end
	-- the server never moves the car, so whenever it streams in it is at the first stop
	e.base = car:GetPivot()
	e.applied = e.y0
	e.doorF = -1
	e.carFloor = car:FindFirstChild("Floor")
	e.anchor = e.carFloor and e.carFloor.Position
	local slide = car:FindFirstChild("Slide")
	for side, sign in pairs({ DoorL = -1, DoorR = 1 }) do
		local door = car:FindFirstChild(side)
		if door then
			e.doorRel[door] = { rel = e.base:ToObjectSpace(door.CFrame), shift = sign * (slide and slide.Value or 2) }
		end
	end
	if e.carFloor then
		e.sounds = {}
		for name, s in pairs(SOUND) do
			local sound = Instance.new("Sound")
			sound.Name = name
			sound.SoundId = s[1]
			sound.Volume = s[2]
			sound.RollOffMode = Enum.RollOffMode.InverseTapered
			sound.RollOffMinDistance = name == "Music" and 3 or 8
			sound.RollOffMaxDistance = name == "Music" and 16 or 60
			sound.Looped = name == "Music"
			sound.Parent = e.carFloor
			e.sounds[name] = sound
		end
	end
end

local function insideCar(e, pos)
	local f = e.carFloor
	if not f or not f.Parent then
		return false
	end
	local rel = f.CFrame:PointToObjectSpace(pos)
	local s = f.Size
	return math.abs(rel.X) < s.X / 2 + 0.2 and math.abs(rel.Z) < s.Z / 2 + 0.2 and rel.Y > -1 and rel.Y < 11
end

local function landingDoors(e, i)
	local d = e.landing[i]
	if d and d.l.Parent and d.r.Parent then
		return d
	end
	local landings = e.model:FindFirstChild("Landings")
	local m = landings and landings:FindFirstChild("Door" .. i)
	local l, r, slide = m and m:FindFirstChild("L"), m and m:FindFirstChild("R"), m and m:FindFirstChild("Slide")
	if not (l and r and slide) then
		e.landing[i] = nil
		return nil
	end
	d = { l = l, r = r, lClosed = l.CFrame, rClosed = r.CFrame, slide = slide.Value, f = 0 }
	e.landing[i] = d
	return d
end

local function setLanding(d, f)
	if d and math.abs(d.f - f) > 1e-4 then
		d.f = f
		d.l.CFrame = d.lClosed * CFrame.new(-d.slide * f, 0, 0)
		d.r.CFrame = d.rClosed * CFrame.new(d.slide * f, 0, 0)
	end
end

local function step(e, t)
	local car = e.model:FindFirstChild("Car")
	if car ~= e.car then
		attachCar(e, car)
	end
	local y = Motion.height(e.plan, t - e.start)
	local s = math.clamp((t - e.doorT) / DOOR_TIME, 0, 1)
	local f = e.doorOpen and s or 1 - s
	f = f * f * (3 - 2 * f)

	if e.car and e.base and (math.abs(y - e.applied) > 1e-4 or math.abs(f - e.doorF) > 1e-4) then
		local delta = y - e.applied
		local cf = e.base + Vector3.new(0, y - e.y0, 0)
		if delta ~= 0 then
			local r = root()
			if r and insideCar(e, r.Position) then
				r.CFrame += Vector3.new(0, delta, 0)
			end
			e.car:PivotTo(cf)
			e.applied = y
		end
		for door, d in pairs(e.doorRel) do
			door.CFrame = cf * d.rel * CFrame.new(d.shift * f, 0, 0)
		end
		e.doorF = f
	end

	if e.landingFloor ~= e.floor then
		if e.landingFloor then
			setLanding(landingDoors(e, e.landingFloor), 0)
		end
		e.landingFloor = e.floor
	end
	setLanding(landingDoors(e, e.floor), f)
end

-- ------------------------------------------------------------------ indicators
local function indicator(part)
	local gui = part:FindFirstChild("Indicator")
	if gui then
		return gui:FindFirstChild("Text", true)
	end
	gui = Instance.new("SurfaceGui")
	gui.Name = "Indicator"
	gui.Face = Enum.NormalId.Back
	gui.LightInfluence = 0
	gui.Brightness = 2
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 60
	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = Color3.fromRGB(8, 10, 14)
	bg.BorderSizePixel = 0
	bg.Parent = gui
	local text = Instance.new("TextLabel")
	text.Name = "Text"
	text.Size = UDim2.fromScale(0.92, 0.8)
	text.Position = UDim2.fromScale(0.04, 0.1)
	text.BackgroundTransparency = 1
	text.Font = Enum.Font.GothamBold
	text.TextScaled = true
	text.TextColor3 = Color3.fromRGB(255, 170, 60)
	text.Parent = bg
	gui.Parent = part
	return text
end

local function nearestStop(e, y)
	local best, bestD = 1, math.huge
	for i, s in ipairs(e.stops) do
		local d = math.abs(s.y - y)
		if d < bestD then
			best, bestD = i, d
		end
	end
	return best
end

local function readout(e, t)
	local y, v = Motion.height(e.plan, t - e.start)
	local i = nearestStop(e, y)
	local arrow = v > 0.05 and "▲ " or v < -0.05 and "▼ " or ""
	return arrow .. e.stops[i].label, i, v
end

local function updateDisplays(e, t)
	local text = readout(e, t)
	local landings = e.model:FindFirstChild("Landings")
	if landings then
		for i = 1, #e.stops do
			local part = landings:FindFirstChild("Display" .. i)
			if part then
				indicator(part).Text = text
			end
		end
	end
	local carDisplay = e.car and e.car:FindFirstChild("CarDisplay")
	if carDisplay then
		indicator(carDisplay).Text = text
	end
end

-- ------------------------------------------------------------------ the panel you see in a car
local gui = Instance.new("ScreenGui")
gui.Name = "ElevatorPanel"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local panel = Instance.new("Frame")
panel.AnchorPoint = Vector2.new(1, 0.5)
panel.Size = UDim2.new(0, 250, 0, 120)
panel.Position = UDim2.new(1, 300, 0.5, 0)
panel.BackgroundColor3 = Color3.fromRGB(14, 20, 24)
panel.BackgroundTransparency = 0.08
panel.Parent = gui
Instance.new("UICorner", panel).CornerRadius = UDim.new(0, 14)
local stroke = Instance.new("UIStroke", panel)
stroke.Color = ACCENT
stroke.Transparency = 0.6
stroke.Thickness = 1.5

local header = Instance.new("TextLabel")
header.Size = UDim2.new(1, -24, 0, 20)
header.Position = UDim2.new(0, 12, 0, 10)
header.BackgroundTransparency = 1
header.Font = Enum.Font.GothamMedium
header.TextSize = 13
header.TextXAlignment = Enum.TextXAlignment.Left
header.TextColor3 = Color3.fromRGB(170, 186, 192)
header.Parent = panel

local big = Instance.new("TextLabel")
big.Size = UDim2.new(1, -24, 0, 46)
big.Position = UDim2.new(0, 12, 0, 30)
big.BackgroundTransparency = 1
big.Font = Enum.Font.GothamBlack
big.TextSize = 40
big.TextXAlignment = Enum.TextXAlignment.Left
big.TextColor3 = Color3.fromRGB(255, 170, 60)
big.Parent = panel

local sub = Instance.new("TextLabel")
sub.Size = UDim2.new(1, -24, 0, 18)
sub.Position = UDim2.new(0, 12, 0, 76)
sub.BackgroundTransparency = 1
sub.Font = Enum.Font.Gotham
sub.TextSize = 14
sub.TextXAlignment = Enum.TextXAlignment.Left
sub.TextColor3 = Color3.fromRGB(225, 233, 236)
sub.Parent = panel

local list = Instance.new("Frame")
list.Position = UDim2.new(0, 10, 0, 102)
list.Size = UDim2.new(1, -20, 0, 0)
list.BackgroundTransparency = 1
list.Parent = panel
local layout = Instance.new("UIListLayout", list)
layout.Padding = UDim.new(0, 6)
layout.SortOrder = Enum.SortOrder.LayoutOrder

local riding, buttons, extras, shown = nil, {}, {}, false

local function button(parent, text, order, onClick)
	local b = Instance.new("TextButton")
	b.LayoutOrder = order
	b.Size = UDim2.new(1, 0, 0, 38)
	b.BackgroundColor3 = Color3.fromRGB(32, 42, 48)
	b.AutoButtonColor = true
	b.Font = Enum.Font.GothamMedium
	b.TextSize = 15
	b.TextXAlignment = Enum.TextXAlignment.Left
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Text = text
	b.Parent = parent
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 10)
	Instance.new("UIPadding", b).PaddingLeft = UDim.new(0, 12)
	b.Activated:Connect(onClick)
	return b
end

local function build(e)
	for _, b in pairs(buttons) do
		b:Destroy()
	end
	for _, b in ipairs(extras) do
		b:Destroy()
	end
	buttons, extras = {}, {}
	header.Text = string.upper(e.name)
	local n = #e.stops
	for i = n, 1, -1 do
		local s = e.stops[i]
		local b = button(list, string.format("%s   %s", s.label, s.title), n - i, function()
			e.pending[i] = true
			remote:FireServer(e.model, "go", i)
		end)
		buttons[i] = b
	end
	local row = Instance.new("Frame")
	row.LayoutOrder = n + 1
	row.Size = UDim2.new(1, 0, 0, 34)
	row.BackgroundTransparency = 1
	row.Parent = list
	table.insert(extras, row)
	for k, spec in ipairs({ { "◀ ▶  Open", "open" }, { "▶ ◀  Close", "close" } }) do
		local b = Instance.new("TextButton")
		b.Size = UDim2.new(0.5, -3, 1, 0)
		b.Position = UDim2.new((k - 1) * 0.5, (k - 1) * 3, 0, 0)
		b.BackgroundColor3 = Color3.fromRGB(24, 32, 38)
		b.Font = Enum.Font.GothamMedium
		b.TextSize = 13
		b.TextColor3 = Color3.fromRGB(200, 214, 220)
		b.Text = spec[1]
		b.Parent = row
		Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
		b.Activated:Connect(function()
			remote:FireServer(e.model, spec[2])
		end)
	end
	local h = 102 + n * 44 + 34 + 14
	list.Size = UDim2.new(1, -20, 0, n * 44 + 34)
	panel.Size = UDim2.new(0, 250, 0, h)
end

local function show(on)
	if on == shown then
		return
	end
	shown = on
	TweenService:Create(panel, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
		Position = on and UDim2.new(1, -18, 0.5, 0) or UDim2.new(1, 300, 0.5, 0),
	}):Play()
end

local function refreshPanel(e, t)
	local text, i, v = readout(e, t)
	big.Text = text
	local moving = math.abs(v) > 0.05
	sub.Text = moving and ("to " .. e.stops[e.target].title) or e.stops[i].title
	for k, b in pairs(buttons) do
		local here = k == i and not moving
		local wanted = e.pending[k] or (moving and k == e.target)
		b.BackgroundColor3 = here and Color3.fromRGB(40, 110, 130)
			or wanted and Color3.fromRGB(150, 96, 30)
			or Color3.fromRGB(32, 42, 48)
	end
end

-- ------------------------------------------------------------------ loops
for _, d in ipairs(workspace:GetDescendants()) do
	if d:IsA("Model") and d.Name == "Elevator" then
		task.spawn(addLift, d)
	end
end
workspace.DescendantAdded:Connect(function(d)
	if d:IsA("Model") and d.Name == "Elevator" then
		task.spawn(addLift, d)
	end
end)

RunService.PreSimulation:Connect(function()
	local t = workspace:GetServerTimeNow()
	for _, e in pairs(lifts) do
		if e.active or e == riding then
			step(e, t)
		end
	end
end)

task.spawn(function()
	while true do
		local t = workspace:GetServerTimeNow()
		local cam = workspace.CurrentCamera
		local r = root()
		local inCar = nil
		for _, e in pairs(lifts) do
			local car = e.model:FindFirstChild("Car")
			if car ~= e.car then
				attachCar(e, car)
			end
			local anchor = e.anchor
			e.active = anchor ~= nil
				and cam ~= nil
				and (Vector3.new(anchor.X, 0, anchor.Z) - Vector3.new(cam.CFrame.X, 0, cam.CFrame.Z)).Magnitude < NEAR
			if e.active then
				updateDisplays(e, t)
				if r and insideCar(e, r.Position) then
					inCar = e
				end
				local music = e.sounds and e.sounds.Music
				if music then
					local close = r and e.carFloor and (r.Position - e.carFloor.Position).Magnitude < 30
					if close and not music.IsPlaying then
						music:Play()
					elseif not close and music.IsPlaying then
						music:Stop()
					end
				end
			end
		end
		if inCar ~= riding then
			riding = inCar
			if riding then
				build(riding)
			end
			show(riding ~= nil)
		end
		if riding then
			refreshPanel(riding, t)
		end
		task.wait(0.1)
	end
end)
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBX08115"><Properties>
<string name="Name">HUD</string>
<ProtectedString name="Source"><![CDATA[-- Welcome card when you join, and a label showing which mall floor, building floor or city
-- district you are in.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local FLOORS = {
	{ y = 0.105, name = "GF", note = "Shops, atrium and main entrance" },
	{ y = 21, name = "1F", note = "Fashion and anchor stores" },
	{ y = 31.5, name = "2F", note = "Food court" },
	{ y = 42, name = "3F", note = "Arcade and games" },
	{ y = 52.5, name = "4F", note = "Cinemas and roof terrace" }
} -- { y = floor top in studs, name, note }
local FOOTPRINTS = {
	{ { -107.3821, -4.1993 }, { 113.981, -4.1993 }, { 113.981, -122.9795 }, { -107.3821, -122.9795 } },
	{ { -113.0812, 18.297 }, { -20.0967, 44.9925 }, { 113.981, 44.9925 }, { 113.981, -122.9795 }, { -113.0812, -122.9795 } },
	{ { -112.4813, 18.297 }, { -50.9915, 45.8924 }, { -20.0967, 45.8924 }, { -20.0967, 63.2894 }, { 113.981, 63.2894 }, { 113.981, -122.9795 }, { -112.4813, -122.9795 } },
	{ { -106.4823, 19.4968 }, { 113.981, 122.9795 }, { 113.981, -122.9795 }, { -107.3821, -122.9795 } },
	{ { -113.981, 24.8958 }, { -1.4998, 24.8958 }, { -1.4998, 69.8884 }, { 113.981, 122.9795 }, { 113.981, -122.9795 }, { -113.981, -122.9795 } }
} -- each floor's outline, { x, z } in studs
local TERRACE = { { -95.0842, 24.8958 }, { -1.4998, 24.8958 }, { -1.4998, 68.7742 } }
local BUILDINGS = {
	{ name = "Studio Nine Music", rect = { -105.8909, 798.8035, -53.3909, 920.6235 }, floors = { { 0.525, "Studio Nine Music" }, { 16.275, "Offices" }, { 91.875, "Roof garden" } } },
	{ name = "Scoop Dreams", rect = { 45.2278, 800.7275, 97.7278, 915.0914 }, floors = { { 0.525, "Scoop Dreams" }, { 16.275, "Offices" }, { 104.475, "Helipad" } } },
	{ name = "Slice Of Napoli", rect = { -103.6806, 639.4707, -7.6681, 691.9707 }, floors = { { 0.525, "Slice Of Napoli" }, { 16.275, "Offices" }, { 66.675, "Rooftop court" } } },
	{ name = "Co-Lab Workspace", rect = { -105.3943, 491.9229, -52.8943, 582.8443 }, floors = { { 0.525, "Co-Lab Workspace" }, { 16.275, "Offices" }, { 66.675, "Rooftop pool" } } },
	{ name = "Byte Labs Store", rect = { 50.7314, 599.9944, 103.2314, 694.4181 }, floors = { { 0.525, "Byte Labs Store" }, { 16.275, "Offices" }, { 79.275, "Rooftop bar" } } },
	{ name = "Pixel Arcade", rect = { 3.109, 488.8609, 100.0953, 541.3609 }, floors = { { 0.525, "Pixel Arcade" }, { 16.275, "Offices" }, { 91.875, "Putting green" } } },
	{ name = "Glass City Bank", rect = { 203.2162, 798.4355, 255.7162, 919.9492 }, floors = { { 0.525, "Glass City Bank" }, { 16.275, "Offices" }, { 91.875, "Roof garden" } } },
	{ name = "Shear Genius Salon", rect = { 352.9501, 798.9701, 405.4501, 914.0649 }, floors = { { 0.525, "Shear Genius Salon" }, { 16.275, "Offices" }, { 104.475, "Helipad" } } },
	{ name = "Paws & Fins", rect = { 206.7128, 643.5186, 299.6072, 696.0186 }, floors = { { 0.525, "Paws & Fins" }, { 16.275, "Offices" }, { 54.075, "Rooftop court" } } },
	{ name = "Freshmart", rect = { 208.1957, 493.8417, 260.6957, 582.6791 }, floors = { { 0.525, "Freshmart" }, { 16.275, "Offices" }, { 104.475, "Rooftop pool" } } },
	{ name = "Strike Lanes Bowling", rect = { 315.9507, 644.4273, 407.0397, 696.9273 }, floors = { { 0.525, "Strike Lanes Bowling" }, { 16.275, "Offices" }, { 117.075, "Rooftop bar" } } },
	{ name = "City Care Clinic", rect = { 352.4899, 493.8541, 404.9899, 587.183 }, floors = { { 0.525, "City Care Clinic" }, { 16.275, "Offices" }, { 91.875, "Putting green" } } },
	{ name = "Aurora Tower", rect = { 512.1742, 794.9795, 608.6616, 920.9795 }, floors = { { 0.525, "Lobby" }, { 153.65, "Sky Garden" } } },
	{ name = "Meridian Tower", rect = { 621.1624, 795.3054, 716.6734, 920.6536 }, floors = { { 0.525, "Lobby" }, { 242.4109, "Sky Club" } } },
	{ name = "Zenith Tower", rect = { 510.9927, 594.0936, 609.8431, 698.3654 }, floors = { { 0.525, "Lobby" }, { 204.0498, "Sky Dining" } } },
	{ name = "Halcyon Tower", rect = { 513.0841, 488.3888, 607.7517, 587.0702 }, floors = { { 0.525, "Lobby" }, { 323.4759, "Infinity Pool" } } },
	{ name = "Solstice Tower", rect = { 619.3123, 595.0711, 718.5235, 697.3879 }, floors = { { 0.525, "Lobby" }, { 219.0361, "Sky Cinema" } } },
	{ name = "Orion Tower", rect = { 508.7344, 186.2529, 612.1014, 283.7061 }, floors = { { 0.525, "Lobby" }, { 364.2027, "Sky Bar" } } },
	{ name = "Vertex Tower", rect = { 512.758, 81.7745, 608.0778, 178.1845 }, floors = { { 0.525, "Lobby" }, { 489.9218, "Observatory" } } },
	{ name = "Lumen Tower", rect = { 619.2759, 188.0768, 718.5599, 281.8822 }, floors = { { 0.525, "Lobby" }, { 432.0287, "Sky Garden" } } },
	{ name = "Cobalt Tower", rect = { 621.4673, 83.8412, 716.3685, 176.1178 }, floors = { { 0.525, "Lobby" }, { 531.0226, "Sky Club" } } },
	{ name = "Nimbus Tower", rect = { 839.8929, 797.8043, 965.8929, 918.1547 }, floors = { { 0.525, "Lobby" }, { 153.65, "Sky Dining" } } },
	{ name = "Glass Spire", rect = { 839.8929, 290.15, 965.8929, 389.809 }, floors = { { 0.525, "Lobby" }, { 660.73, "Observatory" }, { 790.65, "Sky Garden" }, { 790.685, "Skywalk" } } },
	{ name = "Helix Tower", rect = { 839.8929, 186.7354, 965.8929, 283.2236 }, floors = { { 0.525, "Lobby" }, { 455.978, "Infinity Pool" } } },
	{ name = "Prism Tower", rect = { 839.8929, 81.1962, 965.8929, 178.7628 }, floors = { { 0.525, "Lobby" }, { 553.4144, "Sky Cinema" } } },
	{ name = "Atlas Tower", rect = { 839.8929, -23.5592, 965.8929, 73.5182 }, floors = { { 0.525, "Lobby" }, { 363.7401, "Sky Bar" } } },
	{ name = "Summit Tower", rect = { 839.8929, -128.1761, 965.8929, -31.8649 }, floors = { { 0.525, "Lobby" }, { 453.1998, "Observatory" } } },
	{ name = "Jasmine Court", rect = { -104.5821, -883.2705, -55.5821, -739.7705 }, floors = { { 0.525, "Lobby" }, { 80.325, "Penthouse" }, { 93.625, "Roof garden" } } },
	{ name = "Banyan Heights", rect = { -17.0821, -788.7705, 59.9179, -739.7705 }, floors = { { 0.525, "Lobby" }, { 80.325, "Penthouse" }, { 93.625, "Roof garden" } } },
	{ name = "Lotus Residency", rect = { 70.4179, -788.7705, 147.4179, -739.7705 }, floors = { { 0.525, "Lobby" }, { 69.125, "Penthouse" }, { 82.425, "Roof garden" } } },
	{ name = "Skyline Flats", rect = { 157.9179, -788.7705, 234.9179, -739.7705 }, floors = { { 0.525, "Lobby" }, { 69.125, "Penthouse" }, { 82.425, "Roof garden" } } },
	{ name = "Marigold House", rect = { 245.4179, -788.7705, 322.4179, -739.7705 }, floors = { { 0.525, "Lobby" }, { 113.925, "Penthouse" }, { 127.225, "Roof garden" } } },
	{ name = "Cedar Point", rect = { 360.9179, -883.2705, 409.9179, -739.7705 }, floors = { { 0.525, "Lobby" }, { 69.125, "Penthouse" }, { 82.425, "Roof garden" } } },
	{ name = "Coral Apartments", rect = { 511.4179, -883.2705, 560.4179, -739.7705 }, floors = { { 0.525, "Lobby" }, { 102.725, "Penthouse" }, { 116.025, "Roof garden" } } },
	{ name = "Indigo Lofts", rect = { 608.5079, -788.7705, 695.0979, -739.7705 }, floors = { { 0.525, "Lobby" }, { 57.925, "Penthouse" }, { 71.225, "Roof garden" } } },
	{ name = "Peacock Towers", rect = { 705.5979, -788.7705, 792.1879, -739.7705 }, floors = { { 0.525, "Lobby" }, { 102.725, "Penthouse" }, { 116.025, "Roof garden" } } },
	{ name = "Monsoon Villas", rect = { 802.6879, -788.7705, 889.2779, -739.7705 }, floors = { { 0.525, "Lobby" }, { 113.925, "Penthouse" }, { 127.225, "Roof garden" } } },
	{ name = "Tamarind Place", rect = { 937.3679, -883.2705, 986.3679, -739.7705 }, floors = { { 0.525, "Lobby" }, { 69.125, "Penthouse" }, { 82.425, "Roof garden" } } }
} -- every building with a lift: its outline in studs and its floors { y, title }
local DISTRICTS = {
	{ "Glass Mall car park", -123.8321, 255.9795, 121.1679, 406.4795 },
	{ "Glass Mall", -134.3321, -157.0205, 131.6679, 416.9795 },
	{ "VAYU Hotel", -134.3321, -668.0205, 439.6679, -199.0205 },
	{ "Central Park", 173.6679, -157.0205, 439.6679, 416.9795 },
	{ "Stunt Park", 481.6679, -668.0205, 1016.1179, -199.0205 },
	{ "Downtown", 481.6679, -157.0205, 1016.1179, 948.9795 },
	{ "Midtown", -134.3321, 458.9795, 439.6679, 948.9795 },
	{ "Uptown", -134.3321, -913.0205, 1016.1179, -710.0205 },
	{ "Suburbs", -723.3821, -913.0205, -176.3321, 948.9795 },
	{ "Ring Highway", -786.3821, -976.0205, -723.3821, 1011.9795 },
	{ "Ring Highway", 1016.1179, -976.0205, 1079.1179, 1011.9795 },
	{ "Ring Highway", -723.3821, 948.9795, 1016.1179, 1011.9795 },
	{ "Ring Highway", -723.3821, -976.0205, 1016.1179, -913.0205 },
	{ "City streets", -786.3821, -976.0205, 1079.1179, 1011.9795 },
	{ "Glass Bay", 1079.1179, -2327.0205, 4792.6179, 2222.9795 }
} -- { name, x0, z0, x1, z1 } in studs, first match wins
local BLVD = { a = Vector3.new(-131.978, 0, 7.4987), dir = Vector3.new(0.9048, 0, 0.4257), out = Vector3.new(-0.4257, 0, 0.9048), lo = 19.25, hi = 87.5, t0 = -669.072, t1 = 1326.8577 } -- the boulevard: a point on its edge, its direction and the road's span across

local function inside(x, z, poly)
	local c = false
	local j = #poly
	for i = 1, #poly do
		local a, b = poly[i], poly[j]
		if (a[2] > z) ~= (b[2] > z) and x < (b[1] - a[1]) * (z - a[2]) / (b[2] - a[2]) + a[1] then
			c = not c
		end
		j = i
	end
	return c
end

local gui = Instance.new("ScreenGui")
gui.Name = "MallHUD"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local function corner(parent, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r)
	c.Parent = parent
end

local card = Instance.new("Frame")
card.AnchorPoint = Vector2.new(0.5, 0)
card.Size = UDim2.new(0, 360, 0, 196)
card.Position = UDim2.new(0.5, 0, 0, 64)
card.BackgroundColor3 = Color3.fromRGB(14, 20, 24)
card.BackgroundTransparency = 0.15
card.Parent = gui
corner(card, 12)

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -28, 0, 34)
title.Position = UDim2.new(0, 14, 0, 12)
title.BackgroundTransparency = 1
title.Font = Enum.Font.GothamBlack
title.TextSize = 26
title.TextXAlignment = Enum.TextXAlignment.Left
title.TextColor3 = Color3.fromRGB(120, 225, 245)
title.Text = "GLASS CITY"
title.Parent = card

local body = Instance.new("TextLabel")
body.Size = UDim2.new(1, -28, 1, -56)
body.Position = UDim2.new(0, 14, 0, 48)
body.BackgroundTransparency = 1
body.Font = Enum.Font.Gotham
body.TextSize = 15
body.TextWrapped = true
body.TextXAlignment = Enum.TextXAlignment.Left
body.TextYAlignment = Enum.TextYAlignment.Top
body.TextColor3 = Color3.fromRGB(225, 233, 236)
body.Text = "Every building in Glass City has an inside: walk in.\n"
	.. "Call a lift with E and pick a floor on the panel - ride the\n"
	.. "Glass Spire express to its sky lounge and glass skywalk.\n"
	.. "Get a car at a glowing pad. Travel (left) jumps anywhere."
body.Parent = card

task.delay(16, function()
	TweenService:Create(card, TweenInfo.new(1), { Position = UDim2.new(0.5, 0, 0, -260) }):Play()
end)

local pill = Instance.new("TextLabel")
pill.Size = UDim2.new(0, 330, 0, 40)
pill.Position = UDim2.new(0.5, 0, 0, 14)
pill.AnchorPoint = Vector2.new(0.5, 0)
pill.BackgroundColor3 = Color3.fromRGB(14, 20, 24)
pill.BackgroundTransparency = 0.2
pill.Font = Enum.Font.GothamMedium
pill.TextSize = 16
pill.TextColor3 = Color3.new(1, 1, 1)
pill.Text = ""
pill.Parent = gui
corner(pill, 20)

local function district(p)
	local rel = Vector3.new(p.X, 0, p.Z) - BLVD.a
	local d, t = rel:Dot(BLVD.out), rel:Dot(BLVD.dir)
	if d > BLVD.lo and d < BLVD.hi and t > BLVD.t0 and t < BLVD.t1 then
		return "Glass Boulevard"
	end
	for _, r in ipairs(DISTRICTS) do
		if p.X >= r[2] and p.X <= r[4] and p.Z >= r[3] and p.Z <= r[5] then
			return r[1]
		end
	end
	return "Glass Hills"
end

local function building(p)
	for _, b in ipairs(BUILDINGS) do
		local r = b.rect
		if p.X >= r[1] and p.X <= r[3] and p.Z >= r[2] and p.Z <= r[4] then
			local title
			for _, f in ipairs(b.floors) do
				if p.Y >= f[1] - 1 then
					title = f[2]
				end
			end
			return title and (b.name .. "  ·  " .. title) or b.name
		end
	end
	return nil
end

local function where()
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root then
		return ""
	end
	local p = root.Position
	local idx = 1
	for i, f in ipairs(FLOORS) do
		if p.Y >= f.y + 1 then
			idx = i
		end
	end
	local f = FLOORS[idx]
	if inside(p.X, p.Z, FOOTPRINTS[idx]) then
		return f.name .. "  ·  " .. f.note
	end
	if idx == #FLOORS and inside(p.X, p.Z, TERRACE) then
		return "Roof terrace"
	end
	return building(p) or district(p)
end

while true do
	local text = where()
	pill.Text = text
	pill.Visible = text ~= ""
	task.wait(0.25)
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBX08116"><Properties>
<string name="Name">TravelMenu</string>
<ProtectedString name="Source"><![CDATA[-- The Travel button: jump to any district of Glass City.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local event = ReplicatedStorage:WaitForChild("Travel")
local NAMES = { "Glass Mall", "Mall car park", "VAYU Hotel lobby", "VAYU sky pool", "Downtown plaza", "Glass Spire", "Central Park", "Stunt park", "Mega ramp top", "Glass Bay beach", "Pier", "Suburbs", "Midtown", "Uptown" }

local gui = Instance.new("ScreenGui")
gui.Name = "TravelMenu"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local function corner(parent, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r)
	c.Parent = parent
end

local button = Instance.new("TextButton")
button.AnchorPoint = Vector2.new(0, 0.5)
button.Size = UDim2.new(0, 120, 0, 42)
button.Position = UDim2.new(0, 16, 0.5, 0)
button.BackgroundColor3 = Color3.fromRGB(14, 20, 24)
button.BackgroundTransparency = 0.1
button.Font = Enum.Font.GothamBold
button.TextSize = 17
button.TextColor3 = Color3.fromRGB(120, 225, 245)
button.Text = "Travel"
button.Parent = gui
corner(button, 21)

local list = Instance.new("ScrollingFrame") -- scrolls when the screen is too short for every place
list.AnchorPoint = Vector2.new(0, 0.5)
list.Size = UDim2.new(0, 240, 0.8, 0)
list.Position = UDim2.new(0, 146, 0.5, 0)
list.CanvasSize = UDim2.new(0, 0, 0, 46 * #NAMES + 16)
list.ScrollBarThickness = 6
list.BorderSizePixel = 0
local fit = Instance.new("UISizeConstraint")
fit.MaxSize = Vector2.new(240, 46 * #NAMES + 16)
fit.Parent = list
list.BackgroundColor3 = Color3.fromRGB(14, 20, 24)
list.BackgroundTransparency = 0.1
list.Visible = false
list.Parent = gui
corner(list, 14)
local layout = Instance.new("UIListLayout")
layout.Padding = UDim.new(0, 6)
layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.Parent = list
local pad = Instance.new("UIPadding")
pad.PaddingTop = UDim.new(0, 8)
pad.Parent = list

for i, name in ipairs(NAMES) do
	local b = Instance.new("TextButton")
	b.LayoutOrder = i
	b.Size = UDim2.new(1, -20, 0, 40)
	b.BackgroundColor3 = Color3.fromRGB(32, 42, 48)
	b.Font = Enum.Font.GothamMedium
	b.TextSize = 15
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Text = name
	b.Parent = list
	corner(b, 10)
	b.Activated:Connect(function()
		list.Visible = false
		event:FireServer(name)
	end)
end

button.Activated:Connect(function()
	list.Visible = not list.Visible
end)
]]></ProtectedString>
</Properties>
</Item>
</Item>
