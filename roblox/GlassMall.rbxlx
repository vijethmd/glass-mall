<Item class="LocalScript" referent="RBX02BF1"><Properties>
<string name="Name">CarHUD</string>
<ProtectedString name="Source"><![CDATA[-- Speedometer and driving hints while you sit in a car's driver seat.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local KMH = 0.2857 * 3.6 -- studs/s -> km/h at 3.5 studs per metre

local gui = Instance.new("ScreenGui")
gui.Name = "CarHUD"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local panel = Instance.new("Frame")
panel.AnchorPoint = Vector2.new(1, 1)
panel.Size = UDim2.new(0, 210, 0, 92)
panel.Position = UDim2.new(1, -18, 1, -18)
panel.BackgroundColor3 = Color3.fromRGB(14, 20, 24)
panel.BackgroundTransparency = 0.15
panel.Visible = false
panel.Parent = gui
local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = panel

local speed = Instance.new("TextLabel")
speed.Size = UDim2.new(1, -24, 0, 50)
speed.Position = UDim2.new(0, 12, 0, 6)
speed.BackgroundTransparency = 1
speed.Font = Enum.Font.GothamBlack
speed.TextSize = 40
speed.TextXAlignment = Enum.TextXAlignment.Left
speed.TextColor3 = Color3.fromRGB(120, 225, 245)
speed.Parent = panel

local unit = Instance.new("TextLabel")
unit.Size = UDim2.new(0, 60, 0, 50)
unit.Position = UDim2.new(1, -72, 0, 6)
unit.BackgroundTransparency = 1
unit.Font = Enum.Font.GothamMedium
unit.TextSize = 16
unit.TextXAlignment = Enum.TextXAlignment.Right
unit.TextColor3 = Color3.fromRGB(200, 210, 214)
unit.Text = "km/h"
unit.Parent = panel

local hint = Instance.new("TextLabel")
hint.Size = UDim2.new(1, -24, 0, 30)
hint.Position = UDim2.new(0, 12, 0, 56)
hint.BackgroundTransparency = 1
hint.Font = Enum.Font.Gotham
hint.TextSize = 13
hint.TextXAlignment = Enum.TextXAlignment.Left
hint.TextColor3 = Color3.fromRGB(200, 210, 214)
hint.Text = "W/S drive  ·  A/D steer  ·  Space get out"
hint.Parent = panel

RunService.RenderStepped:Connect(function()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local seat = humanoid and humanoid.SeatPart
	if seat and seat:IsA("VehicleSeat") then
		panel.Visible = true
		speed.Text = tostring(math.floor(seat.AssemblyLinearVelocity.Magnitude * KMH + 0.5))
	else
		panel.Visible = false
	end
end)
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBX02BF2"><Properties>
<string name="Name">ClientFX</string>
<ProtectedString name="Source"><![CDATA[-- Animates the LED walls, cinema screens and arcade marquees, and spins the coins, on
-- each player's screen.
local RunService = game:GetService("RunService")

local coins = workspace:WaitForChild("Coins")
local home = setmetatable({}, { __mode = "k" }) -- each coin's resting position

local gradients = {}
local function track(d)
	if d:IsA("UIGradient") and d.Name == "Anim" then
		table.insert(gradients, d)
	end
end
for _, d in ipairs(workspace:GetDescendants()) do
	track(d)
end
workspace.DescendantAdded:Connect(track)

local t = 0
RunService.RenderStepped:Connect(function(dt)
	t = t + dt
	for i = #gradients, 1, -1 do
		local g = gradients[i]
		if g.Parent then
			g.Rotation = (t * 18 + i * 40) % 360
			g.Offset = Vector2.new(math.sin(t * 0.5 + i) * 0.4, 0)
		else
			table.remove(gradients, i)
		end
	end
	for i, coin in ipairs(coins:GetChildren()) do
		local p = home[coin]
		if not p then
			p = coin.Position
			home[coin] = p
		end
		coin.CFrame = CFrame.new(p + Vector3.new(0, math.sin(t * 2 + i) * 0.4, 0)) * CFrame.Angles(0, t * 2.5 + i, 0)
	end
end)
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBX02BF3"><Properties>
<string name="Name">HUD</string>
<ProtectedString name="Source"><![CDATA[-- Welcome card when you join, and a label showing which mall floor or city district you
-- are in.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local FLOORS = {
	{ y = 0.105, name = "GF", note = "Shops, atrium and main entrance" },
	{ y = 21, name = "1F", note = "Fashion and anchor stores" },
	{ y = 31.5, name = "2F", note = "Food court" },
	{ y = 42, name = "3F", note = "Arcade and games" },
	{ y = 52.5, name = "4F", note = "Cinemas and roof terrace" }
} -- { y = floor top in studs, name, note }
local FOOTPRINTS = {
	{ { -107.3821, -4.1993 }, { 113.981, -4.1993 }, { 113.981, -122.9795 }, { -107.3821, -122.9795 } },
	{ { -113.0812, 18.297 }, { -20.0967, 44.9925 }, { 113.981, 44.9925 }, { 113.981, -122.9795 }, { -113.0812, -122.9795 } },
	{ { -112.4813, 18.297 }, { -50.9915, 45.8924 }, { -20.0967, 45.8924 }, { -20.0967, 63.2894 }, { 113.981, 63.2894 }, { 113.981, -122.9795 }, { -112.4813, -122.9795 } },
	{ { -106.4823, 19.4968 }, { 113.981, 122.9795 }, { 113.981, -122.9795 }, { -107.3821, -122.9795 } },
	{ { -113.981, 24.8958 }, { -1.4998, 24.8958 }, { -1.4998, 69.8884 }, { 113.981, 122.9795 }, { 113.981, -122.9795 }, { -113.981, -122.9795 } }
} -- each floor's outline, { x, z } in studs
local TERRACE = { { -95.0842, 24.8958 }, { -1.4998, 24.8958 }, { -1.4998, 68.7742 } }
local DISTRICTS = {
	{ "Glass Mall car park", -123.8321, 255.9795, 121.1679, 406.4795 },
	{ "Glass Mall", -134.3321, -157.0205, 131.6679, 416.9795 },
	{ "VAYU Hotel", -134.3321, -668.0205, 439.6679, -199.0205 },
	{ "Central Park", 173.6679, -157.0205, 439.6679, 416.9795 },
	{ "Stunt Park", 481.6679, -668.0205, 1016.1179, -199.0205 },
	{ "Downtown", 481.6679, -157.0205, 1016.1179, 948.9795 },
	{ "Midtown", -134.3321, 458.9795, 439.6679, 948.9795 },
	{ "Uptown", -134.3321, -913.0205, 1016.1179, -710.0205 },
	{ "Suburbs", -723.3821, -913.0205, -176.3321, 948.9795 },
	{ "Ring Highway", -786.3821, -976.0205, -723.3821, 1011.9795 },
	{ "Ring Highway", 1016.1179, -976.0205, 1079.1179, 1011.9795 },
	{ "Ring Highway", -723.3821, 948.9795, 1016.1179, 1011.9795 },
	{ "Ring Highway", -723.3821, -976.0205, 1016.1179, -913.0205 },
	{ "City streets", -786.3821, -976.0205, 1079.1179, 1011.9795 },
	{ "Glass Bay", 1079.1179, -2327.0205, 4792.6179, 2222.9795 }
} -- { name, x0, z0, x1, z1 } in studs, first match wins
local BLVD = { a = Vector3.new(-131.978, 0, 7.4987), dir = Vector3.new(0.9048, 0, 0.4257), out = Vector3.new(-0.4257, 0, 0.9048), lo = 19.25, hi = 87.5, t0 = -669.072, t1 = 1326.8577 } -- the boulevard: a point on its edge, its direction and the road's span across

local function inside(x, z, poly)
	local c = false
	local j = #poly
	for i = 1, #poly do
		local a, b = poly[i], poly[j]
		if (a[2] > z) ~= (b[2] > z) and x < (b[1] - a[1]) * (z - a[2]) / (b[2] - a[2]) + a[1] then
			c = not c
		end
		j = i
	end
	return c
end

local gui = Instance.new("ScreenGui")
gui.Name = "MallHUD"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local function corner(parent, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r)
	c.Parent = parent
end

local card = Instance.new("Frame")
card.AnchorPoint = Vector2.new(0.5, 0)
card.Size = UDim2.new(0, 360, 0, 196)
card.Position = UDim2.new(0.5, 0, 0, 64)
card.BackgroundColor3 = Color3.fromRGB(14, 20, 24)
card.BackgroundTransparency = 0.15
card.Parent = gui
corner(card, 12)

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -28, 0, 34)
title.Position = UDim2.new(0, 14, 0, 12)
title.BackgroundTransparency = 1
title.Font = Enum.Font.GothamBlack
title.TextSize = 26
title.TextXAlignment = Enum.TextXAlignment.Left
title.TextColor3 = Color3.fromRGB(120, 225, 245)
title.Text = "GLASS CITY"
title.Parent = card

local body = Instance.new("TextLabel")
body.Size = UDim2.new(1, -28, 1, -56)
body.Position = UDim2.new(0, 14, 0, 48)
body.BackgroundTransparency = 1
body.Font = Enum.Font.Gotham
body.TextSize = 15
body.TextWrapped = true
body.TextXAlignment = Enum.TextXAlignment.Left
body.TextYAlignment = Enum.TextYAlignment.Top
body.TextColor3 = Color3.fromRGB(225, 233, 236)
body.Text = "The Glass Mall now sits in a whole city.\n"
	.. "Get a car at a glowing pad, or press E by any parked car.\n"
	.. "Travel (left) jumps to any district. Collect the gold coins.\n"
	.. "Mall: 2F food court  ·  3F arcade  ·  4F cinemas"
body.Parent = card

task.delay(16, function()
	TweenService:Create(card, TweenInfo.new(1), { Position = UDim2.new(0.5, 0, 0, -260) }):Play()
end)

local pill = Instance.new("TextLabel")
pill.Size = UDim2.new(0, 330, 0, 40)
pill.Position = UDim2.new(0.5, 0, 0, 14)
pill.AnchorPoint = Vector2.new(0.5, 0)
pill.BackgroundColor3 = Color3.fromRGB(14, 20, 24)
pill.BackgroundTransparency = 0.2
pill.Font = Enum.Font.GothamMedium
pill.TextSize = 16
pill.TextColor3 = Color3.new(1, 1, 1)
pill.Text = ""
pill.Parent = gui
corner(pill, 20)

local function district(p)
	local rel = Vector3.new(p.X, 0, p.Z) - BLVD.a
	local d, t = rel:Dot(BLVD.out), rel:Dot(BLVD.dir)
	if d > BLVD.lo and d < BLVD.hi and t > BLVD.t0 and t < BLVD.t1 then
		return "Glass Boulevard"
	end
	for _, r in ipairs(DISTRICTS) do
		if p.X >= r[2] and p.X <= r[4] and p.Z >= r[3] and p.Z <= r[5] then
			return r[1]
		end
	end
	return "Glass Hills"
end

local function where()
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root then
		return ""
	end
	local p = root.Position
	local idx = 1
	for i, f in ipairs(FLOORS) do
		if p.Y >= f.y + 1 then
			idx = i
		end
	end
	local f = FLOORS[idx]
	if inside(p.X, p.Z, FOOTPRINTS[idx]) then
		return f.name .. "  ·  " .. f.note
	end
	if idx == #FLOORS and inside(p.X, p.Z, TERRACE) then
		return "Roof terrace"
	end
	return district(p)
end

while true do
	local text = where()
	pill.Text = text
	pill.Visible = text ~= ""
	task.wait(0.25)
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBX02BF4"><Properties>
<string name="Name">TravelMenu</string>
<ProtectedString name="Source"><![CDATA[-- The Travel button: jump to any district of Glass City.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local event = ReplicatedStorage:WaitForChild("Travel")
local NAMES = { "Glass Mall", "Mall car park", "VAYU Hotel lobby", "VAYU sky pool", "Downtown plaza", "Central Park", "Stunt park", "Mega ramp top", "Glass Bay beach", "Pier", "Suburbs", "Midtown", "Uptown" }

local gui = Instance.new("ScreenGui")
gui.Name = "TravelMenu"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local function corner(parent, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r)
	c.Parent = parent
end

local button = Instance.new("TextButton")
button.AnchorPoint = Vector2.new(0, 0.5)
button.Size = UDim2.new(0, 120, 0, 42)
button.Position = UDim2.new(0, 16, 0.5, 0)
button.BackgroundColor3 = Color3.fromRGB(14, 20, 24)
button.BackgroundTransparency = 0.1
button.Font = Enum.Font.GothamBold
button.TextSize = 17
button.TextColor3 = Color3.fromRGB(120, 225, 245)
button.Text = "Travel"
button.Parent = gui
corner(button, 21)

local list = Instance.new("ScrollingFrame") -- scrolls when the screen is too short for every place
list.AnchorPoint = Vector2.new(0, 0.5)
list.Size = UDim2.new(0, 240, 0.8, 0)
list.Position = UDim2.new(0, 146, 0.5, 0)
list.CanvasSize = UDim2.new(0, 0, 0, 46 * #NAMES + 16)
list.ScrollBarThickness = 6
list.BorderSizePixel = 0
local fit = Instance.new("UISizeConstraint")
fit.MaxSize = Vector2.new(240, 46 * #NAMES + 16)
fit.Parent = list
list.BackgroundColor3 = Color3.fromRGB(14, 20, 24)
list.BackgroundTransparency = 0.1
list.Visible = false
list.Parent = gui
corner(list, 14)
local layout = Instance.new("UIListLayout")
layout.Padding = UDim.new(0, 6)
layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.Parent = list
local pad = Instance.new("UIPadding")
pad.PaddingTop = UDim.new(0, 8)
pad.Parent = list

for i, name in ipairs(NAMES) do
	local b = Instance.new("TextButton")
	b.LayoutOrder = i
	b.Size = UDim2.new(1, -20, 0, 40)
	b.BackgroundColor3 = Color3.fromRGB(32, 42, 48)
	b.Font = Enum.Font.GothamMedium
	b.TextSize = 15
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Text = name
	b.Parent = list
	corner(b, 10)
	b.Activated:Connect(function()
		list.Visible = false
		event:FireServer(name)
	end)
end

button.Activated:Connect(function()
	list.Visible = not list.Visible
end)
]]></ProtectedString>
</Properties>
</Item>
</Item>
