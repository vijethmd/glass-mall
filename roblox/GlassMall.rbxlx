<Item class="ServerScriptService" referent="RBX010B7"><Properties>
<string name="Name">ServerScriptService</string>
</Properties>
<Item class="Script" referent="RBX010B8"><Properties>
<string name="Name">DayNight</string>
<ProtectedString name="Source"><![CDATA[-- A full day passes in MINUTES_PER_DAY real minutes. Street lights come on at dusk.
local Lighting = game:GetService("Lighting")

local MINUTES_PER_DAY = 16

local lamps = {}
for _, d in ipairs(workspace.Site.StreetLights:GetDescendants()) do
	if d:IsA("Light") then
		table.insert(lamps, d)
	end
end

local wasNight = nil
while true do
	local dt = task.wait(0.1)
	Lighting.ClockTime = (Lighting.ClockTime + dt * 24 / (MINUTES_PER_DAY * 60)) % 24
	local t = Lighting.ClockTime
	local night = t < 6.3 or t > 17.8
	if night ~= wasNight then
		wasNight = night
		for _, lamp in ipairs(lamps) do
			lamp.Enabled = night
			if lamp.Parent:IsA("BasePart") then
				lamp.Parent.Material = night and Enum.Material.Neon or Enum.Material.SmoothPlastic
			end
		end
	end
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="Script" referent="RBX010B9"><Properties>
<string name="Name">Doors</string>
<ProtectedString name="Source"><![CDATA[-- Automatic sliding doors: they open when a player or a shopper comes close and
-- close again when nobody is near. Each door is a Model with panels L and R and
-- a NumberValue "Slide" (how far each panel moves, in studs).
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local RANGE = 14
local INFO = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local doors = {}
for _, model in ipairs(workspace.Mall.Doors:GetChildren()) do
	local l, r, slide = model:FindFirstChild("L"), model:FindFirstChild("R"), model:FindFirstChild("Slide")
	if l and r and slide then
		table.insert(doors, {
			l = l,
			r = r,
			lClosed = l.CFrame,
			rClosed = r.CFrame,
			lOpen = l.CFrame * CFrame.new(-slide.Value, 0, 0),
			rOpen = r.CFrame * CFrame.new(slide.Value, 0, 0),
			centre = (l.Position + r.Position) / 2,
			open = false,
		})
	end
end

local function walkers()
	local list = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root then
			table.insert(list, root.Position)
		end
	end
	local shoppers = workspace:FindFirstChild("Shoppers")
	if shoppers then
		for _, npc in ipairs(shoppers:GetChildren()) do
			local root = npc:FindFirstChild("HumanoidRootPart")
			if root then
				table.insert(list, root.Position)
			end
		end
	end
	return list
end

while true do
	local here = walkers()
	for _, door in ipairs(doors) do
		local near = false
		for _, p in ipairs(here) do
			if (p - door.centre).Magnitude < RANGE then
				near = true
				break
			end
		end
		if near ~= door.open then
			door.open = near
			TweenService:Create(door.l, INFO, { CFrame = near and door.lOpen or door.lClosed }):Play()
			TweenService:Create(door.r, INFO, { CFrame = near and door.rOpen or door.rClosed }):Play()
		end
	end
	task.wait(0.15)
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="Script" referent="RBX010BA"><Properties>
<string name="Name">Escalators</string>
<ProtectedString name="Source"><![CDATA[-- Escalator treads are anchored parts with a surface velocity, so anyone standing
-- on one is carried up the slope (you can still walk down against it).
local SPEED = 5

for _, part in ipairs(workspace.Mall.Escalators:GetDescendants()) do
	if part:IsA("BasePart") and part.Name == "Tread" then
		part.AssemblyLinearVelocity = part.CFrame.XVector * SPEED
	end
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="Script" referent="RBX010BB"><Properties>
<string name="Name">Lift</string>
<ProtectedString name="Source"><![CDATA[-- The glass lift beside the shops. Click a floor button inside the car, or the
-- call button (or prompt) on any landing. Landing doors open only when the car is there.
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local STOPS = { 0.105, 21, 31.5, 42, 52.5 } -- floor tops in studs: GF, 1F, 2F, 3F, 4F
local SPEED = 9
local INFO = TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)

local lift = workspace.Mall.Lift
local car = lift.Car
local floor = car:WaitForChild("Floor")

local landings = {}
for i = 1, #STOPS do
	local door = lift.Landings:FindFirstChild("Door" .. i)
	if door then
		local l, r, slide = door.L, door.R, door.Slide.Value
		landings[i] = {
			l = l,
			r = r,
			lClosed = l.CFrame,
			rClosed = r.CFrame,
			lOpen = l.CFrame * CFrame.new(-slide, 0, 0),
			rOpen = r.CFrame * CFrame.new(slide, 0, 0),
		}
	end
end

local function setDoors(i, open)
	local d = landings[i]
	if not d then
		return
	end
	TweenService:Create(d.l, INFO, { CFrame = open and d.lOpen or d.lClosed }):Play()
	TweenService:Create(d.r, INFO, { CFrame = open and d.rOpen or d.rClosed }):Play()
end

local current = 1
local moving = false
local queue = {}

local function request(i)
	if i == current and not moving then
		setDoors(current, true)
		return
	end
	for _, q in ipairs(queue) do
		if q == i then
			return
		end
	end
	table.insert(queue, i)
end

local function topOfFloor()
	return floor.Position.Y + floor.Size.Y / 2
end

local function travel(target)
	setDoors(current, false)
	task.wait(1)
	moving = true
	local goal = STOPS[target]
	while true do
		local dt = RunService.Heartbeat:Wait()
		local remaining = goal - topOfFloor()
		if math.abs(remaining) < 0.02 then
			break
		end
		local dir = remaining > 0 and 1 or -1
		local step = dir * math.min(SPEED * dt, math.abs(remaining))
		floor.AssemblyLinearVelocity = Vector3.new(0, dir * SPEED, 0)
		car:PivotTo(car:GetPivot() + Vector3.new(0, step, 0))
	end
	floor.AssemblyLinearVelocity = Vector3.zero
	moving = false
	current = target
end

for _, button in ipairs(car:GetChildren()) do
	local n = tonumber(string.match(button.Name, "^Button(%d)$"))
	local click = button:FindFirstChildOfClass("ClickDetector")
	if n and click then
		click.MouseClick:Connect(function()
			request(n)
		end)
	end
end

for i = 1, #STOPS do
	local call = lift.Landings:FindFirstChild("Call" .. i)
	if call then
		local click = call:FindFirstChildOfClass("ClickDetector")
		local prompt = call:FindFirstChildOfClass("ProximityPrompt")
		if click then
			click.MouseClick:Connect(function()
				request(i)
			end)
		end
		if prompt then
			prompt.Triggered:Connect(function()
				request(i)
			end)
		end
	end
end

setDoors(current, true)
while true do
	if #queue > 0 then
		local target = table.remove(queue, 1)
		if target ~= current then
			travel(target)
		end
		setDoors(current, true)
		task.wait(4)
	else
		task.wait(0.2)
	end
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="Script" referent="RBX010BC"><Properties>
<string name="Name">Shoppers</string>
<ProtectedString name="Source"><![CDATA[-- Shoppers arrive from the street, walk into the mall through the automatic doors,
-- visit one to three places (shops, food court, arcade, cinemas, terrace) and walk
-- back out. Each leaves and a new one arrives, so the mall always has some life.
local Players = game:GetService("Players")
local PathfindingService = game:GetService("PathfindingService")

local COUNT = 14
local street = workspace.Waypoints.Street:GetChildren()
local inside = workspace.Waypoints.Inside:GetChildren()
local folder = workspace:FindFirstChild("Shoppers")
local rng = Random.new()

local SKIN = {
	Color3.fromRGB(255, 220, 190), Color3.fromRGB(234, 184, 146), Color3.fromRGB(198, 140, 100),
	Color3.fromRGB(160, 105, 72), Color3.fromRGB(120, 78, 52), Color3.fromRGB(86, 58, 40),
}
local TOPS = {
	Color3.fromRGB(230, 90, 70), Color3.fromRGB(60, 120, 200), Color3.fromRGB(245, 245, 240),
	Color3.fromRGB(40, 44, 52), Color3.fromRGB(240, 190, 60), Color3.fromRGB(90, 170, 120),
	Color3.fromRGB(200, 120, 200), Color3.fromRGB(120, 200, 230),
}
local BOTTOMS = {
	Color3.fromRGB(40, 50, 80), Color3.fromRGB(30, 30, 34), Color3.fromRGB(150, 130, 100),
	Color3.fromRGB(90, 90, 96), Color3.fromRGB(60, 80, 120),
}

local function pick(list)
	return list[rng:NextInteger(1, #list)]
end

local function simpleBody(colour)
	local model = Instance.new("Model")
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2, 5, 1.4)
	root.Color = colour
	root.Parent = model
	local humanoid = Instance.new("Humanoid")
	humanoid.RigType = Enum.HumanoidRigType.R15
	humanoid.HipHeight = 0
	humanoid.Parent = model
	model.PrimaryPart = root
	return model
end

local function makeShopper(at)
	local desc = Instance.new("HumanoidDescription")
	local skin, top, bottom = pick(SKIN), pick(TOPS), pick(BOTTOMS)
	desc.HeadColor = skin
	desc.LeftArmColor = skin
	desc.RightArmColor = skin
	desc.TorsoColor = top
	desc.LeftLegColor = bottom
	desc.RightLegColor = bottom
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		model = simpleBody(top)
	end
	model.Name = "Shopper"
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	humanoid.WalkSpeed = rng:NextNumber(7, 10)
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	model:PivotTo(CFrame.new(at.Position + Vector3.new(0, 3.2, 0)))
	model.Parent = folder
	local root = model:FindFirstChild("HumanoidRootPart")
	if root then
		pcall(function()
			root:SetNetworkOwner(nil)
		end)
	end
	return model, humanoid
end

local function walkTo(model, humanoid, target)
	local root = model:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local path = PathfindingService:CreatePath({
		AgentRadius = 1.5,
		AgentHeight = 5,
		AgentCanJump = false,
		WaypointSpacing = 5,
		Costs = { Door = 1 },
	})
	local points = {}
	local ok = pcall(function()
		path:ComputeAsync(root.Position, target)
	end)
	if ok and path.Status == Enum.PathStatus.Success then
		for _, w in ipairs(path:GetWaypoints()) do
			table.insert(points, w.Position)
		end
	else
		points = { target }
	end
	for _, p in ipairs(points) do
		if not model.Parent or humanoid.Health <= 0 then
			return
		end
		humanoid:MoveTo(p)
		if not humanoid.MoveToFinished:Wait() then
			humanoid:MoveTo(p)
			if not humanoid.MoveToFinished:Wait() then
				return
			end
		end
	end
end

local function life()
	while true do
		local model, humanoid = makeShopper(pick(street))
		for _ = 1, rng:NextInteger(1, 3) do
			walkTo(model, humanoid, pick(inside).Position)
			task.wait(rng:NextNumber(3, 9))
		end
		walkTo(model, humanoid, pick(street).Position)
		model:Destroy()
		task.wait(rng:NextNumber(2, 8))
	end
end

for _ = 1, COUNT do
	task.spawn(life)
	task.wait(1.5)
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="Script" referent="RBX010BD"><Properties>
<string name="Name">Signage</string>
<ProtectedString name="Source"><![CDATA[-- Builds every sign in the place from the values stored on its part:
--   SignText (StringValue)  what it says
--   Face     (StringValue)  which face of the part it is drawn on (default Back)
--   Style    (StringValue)  fascia | led | screen | directory | button
--   Accent   (Color3Value)  second colour for animated signs
-- Gradients named "Anim" are animated on each player's screen by ClientFX.
local function gradient(frame, c0, c1)
	local g = Instance.new("UIGradient")
	g.Name = "Anim"
	g.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, c0),
		ColorSequenceKeypoint.new(0.5, c1),
		ColorSequenceKeypoint.new(1, c0),
	})
	g.Parent = frame
end

local function build(part)
	local text = part:FindFirstChild("SignText")
	local face = part:FindFirstChild("Face")
	local style = part:FindFirstChild("Style")
	local accent = part:FindFirstChild("Accent")
	local kind = style and style.Value or "fascia"

	local gui = Instance.new("SurfaceGui")
	gui.Name = "Sign"
	gui.Face = Enum.NormalId[face and face.Value or "Back"]
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = kind == "button" and 80 or 30
	gui.LightInfluence = 0
	gui.Brightness = kind == "screen" and 2 or 1.5

	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1, 1)
	bg.BorderSizePixel = 0
	bg.BackgroundTransparency = 1
	bg.Parent = gui

	if kind == "led" or kind == "screen" then
		bg.BackgroundTransparency = 0
		bg.BackgroundColor3 = Color3.new(1, 1, 1)
		local base = kind == "led" and Color3.fromRGB(16, 30, 120) or Color3.fromRGB(26, 18, 54)
		gradient(bg, base, accent and accent.Value or Color3.fromRGB(210, 50, 170))
	elseif kind == "directory" then
		bg.BackgroundTransparency = 0.05
		bg.BackgroundColor3 = Color3.fromRGB(18, 22, 26)
	elseif kind == "button" then
		bg.BackgroundTransparency = 0
		bg.BackgroundColor3 = Color3.fromRGB(30, 34, 40)
	end

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.Font = kind == "directory" and Enum.Font.Gotham or Enum.Font.GothamBold
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Text = text.Value
	if kind == "directory" then
		label.Size = UDim2.fromScale(0.86, 0.86)
		label.Position = UDim2.fromScale(0.07, 0.07)
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.TextYAlignment = Enum.TextYAlignment.Top
	elseif kind == "screen" then
		label.Size = UDim2.fromScale(0.8, 0.5)
		label.Position = UDim2.fromScale(0.1, 0.25)
	else
		label.Size = UDim2.fromScale(0.9, 0.72)
		label.Position = UDim2.fromScale(0.05, 0.14)
	end
	label.Parent = bg
	gui.Parent = part
end

for _, d in ipairs(workspace:GetDescendants()) do
	if d:IsA("BasePart") and d:FindFirstChild("SignText") then
		build(d)
	end
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="Script" referent="RBX010BE"><Properties>
<string name="Name">Traffic</string>
<ProtectedString name="Source"><![CDATA[-- Cars drive along the main road in both directions and loop round.
local RunService = game:GetService("RunService")

local START = Vector3.new(-1082.0616, 0, -439.5372) -- road start, studs
local DIR = Vector3.new(0.9048, 0, 0.4257) -- unit vector along the road
local ACROSS = Vector3.new(-0.4257, 0, 0.9048) -- unit vector across the road, away from the mall
local LENGTH = 2398.0136
local LANES = { { 28.7, 1 }, { 40.6, 1 }, { 65.1, -1 }, { 77, -1 } } -- offset across the road (studs) and direction (+1 / -1)
local CAR_Y = 2.275

local rng = Random.new(3)
local cars = {}
for i, model in ipairs(workspace.Site.Cars:GetChildren()) do
	local lane = LANES[(i - 1) % #LANES + 1]
	table.insert(cars, {
		model = model,
		s = rng:NextNumber(0, LENGTH),
		offset = lane[1],
		dir = lane[2],
		speed = rng:NextNumber(32, 48),
	})
end

RunService.Heartbeat:Connect(function(dt)
	for _, car in ipairs(cars) do
		car.s = (car.s + car.dir * car.speed * dt) % LENGTH
		local pos = START + DIR * car.s + ACROSS * car.offset + Vector3.new(0, CAR_Y, 0)
		car.model:PivotTo(CFrame.lookAt(pos, pos + DIR * car.dir))
	end
end)
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="StarterPlayer" referent="RBX010BF"><Properties>
<string name="Name">StarterPlayer</string>
</Properties>
<Item class="StarterPlayerScripts" referent="RBX010C0"><Properties>
<string name="Name">StarterPlayerScripts</string>
</Properties>
<Item class="LocalScript" referent="RBX010C1"><Properties>
<string name="Name">ClientFX</string>
<ProtectedString name="Source"><![CDATA[-- Animates the LED wall, cinema screens and arcade marquees on each player's screen.
local RunService = game:GetService("RunService")

local gradients = {}
local function track(d)
	if d:IsA("UIGradient") and d.Name == "Anim" then
		table.insert(gradients, d)
	end
end
for _, d in ipairs(workspace:GetDescendants()) do
	track(d)
end
workspace.DescendantAdded:Connect(track)

local t = 0
RunService.RenderStepped:Connect(function(dt)
	t = t + dt
	for i = #gradients, 1, -1 do
		local g = gradients[i]
		if g.Parent then
			g.Rotation = (t * 18 + i * 40) % 360
			g.Offset = Vector2.new(math.sin(t * 0.5 + i) * 0.4, 0)
		else
			table.remove(gradients, i)
		end
	end
end)
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBX010C2"><Properties>
<string name="Name">HUD</string>
<ProtectedString name="Source"><![CDATA[-- Welcome card when you join, and a label showing which floor you are on.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local FLOORS = {
	{ y = 0.105, name = "GF", note = "Shops, atrium and main entrance" },
	{ y = 21, name = "1F", note = "Fashion and anchor stores" },
	{ y = 31.5, name = "2F", note = "Food court" },
	{ y = 42, name = "3F", note = "Arcade and games" },
	{ y = 52.5, name = "4F", note = "Cinemas and roof terrace" }
} -- { y = floor top in studs, name, note }
local FOOTPRINTS = {
	{ { -107.3821, -4.1993 }, { 113.981, -4.1993 }, { 113.981, -122.9795 }, { -107.3821, -122.9795 } },
	{ { -113.0812, 18.297 }, { -20.0967, 44.9925 }, { 113.981, 44.9925 }, { 113.981, -122.9795 }, { -113.0812, -122.9795 } },
	{ { -112.4813, 18.297 }, { -50.9915, 45.8924 }, { -20.0967, 45.8924 }, { -20.0967, 63.2894 }, { 113.981, 63.2894 }, { 113.981, -122.9795 }, { -112.4813, -122.9795 } },
	{ { -106.4823, 19.4968 }, { 113.981, 122.9795 }, { 113.981, -122.9795 }, { -107.3821, -122.9795 } },
	{ { -113.981, 24.8958 }, { -1.4998, 24.8958 }, { -1.4998, 69.8884 }, { 113.981, 122.9795 }, { 113.981, -122.9795 }, { -113.981, -122.9795 } }
} -- each floor's outline, { x, z } in studs
local TERRACE = { { -95.0842, 24.8958 }, { -1.4998, 24.8958 }, { -1.4998, 68.7742 } }

local function inside(x, z, poly)
	local c = false
	local j = #poly
	for i = 1, #poly do
		local a, b = poly[i], poly[j]
		if (a[2] > z) ~= (b[2] > z) and x < (b[1] - a[1]) * (z - a[2]) / (b[2] - a[2]) + a[1] then
			c = not c
		end
		j = i
	end
	return c
end

local gui = Instance.new("ScreenGui")
gui.Name = "MallHUD"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local function corner(parent, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r)
	c.Parent = parent
end

local card = Instance.new("Frame")
card.Size = UDim2.new(0, 330, 0, 168)
card.Position = UDim2.new(0, 16, 0, 16)
card.BackgroundColor3 = Color3.fromRGB(14, 20, 24)
card.BackgroundTransparency = 0.15
card.Parent = gui
corner(card, 12)

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -28, 0, 34)
title.Position = UDim2.new(0, 14, 0, 12)
title.BackgroundTransparency = 1
title.Font = Enum.Font.GothamBlack
title.TextSize = 26
title.TextXAlignment = Enum.TextXAlignment.Left
title.TextColor3 = Color3.fromRGB(120, 225, 245)
title.Text = "GLASS MALL"
title.Parent = card

local body = Instance.new("TextLabel")
body.Size = UDim2.new(1, -28, 1, -56)
body.Position = UDim2.new(0, 14, 0, 48)
body.BackgroundTransparency = 1
body.Font = Enum.Font.Gotham
body.TextSize = 15
body.TextWrapped = true
body.TextXAlignment = Enum.TextXAlignment.Left
body.TextYAlignment = Enum.TextYAlignment.Top
body.TextColor3 = Color3.fromRGB(225, 233, 236)
body.Text = "Walk in through the glass doors on the court.\n"
	.. "Escalators by the atrium and the lift beside the shops reach every floor.\n"
	.. "2F food court  ·  3F arcade  ·  4F cinemas and roof terrace"
body.Parent = card

task.delay(16, function()
	TweenService:Create(card, TweenInfo.new(1), { Position = UDim2.new(0, -360, 0, 16) }):Play()
end)

local pill = Instance.new("TextLabel")
pill.AnchorPoint = Vector2.new(0.5, 1)
pill.Size = UDim2.new(0, 330, 0, 40)
pill.Position = UDim2.new(0.5, 0, 1, -18)
pill.BackgroundColor3 = Color3.fromRGB(14, 20, 24)
pill.BackgroundTransparency = 0.2
pill.Font = Enum.Font.GothamMedium
pill.TextSize = 16
pill.TextColor3 = Color3.new(1, 1, 1)
pill.Text = ""
pill.Parent = gui
corner(pill, 20)

local function where()
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root then
		return ""
	end
	local p = root.Position
	local idx = 1
	for i, f in ipairs(FLOORS) do
		if p.Y >= f.y + 1 then
			idx = i
		end
	end
	local f = FLOORS[idx]
	if inside(p.X, p.Z, FOOTPRINTS[idx]) then
		return f.name .. "  ·  " .. f.note
	end
	if idx == #FLOORS and inside(p.X, p.Z, TERRACE) then
		return "Roof terrace"
	end
	if idx == 1 then
		return "Outside  ·  entrance court"
	end
	return f.name
end

while true do
	local text = where()
	pill.Text = text
	pill.Visible = text ~= ""
	task.wait(0.25)
end
]]></ProtectedString>
</Properties>
</Item>
</Item>
